{% schema %}
{
  "name": "V5 Product Listing",
  "tag": "section",
  "class": "maxfoot-v5-product-listing",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "ENGINEERED SERIES"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "Pushing the boundaries of electric mobility. Our Engineered Series combines high-performance power units with aerospace-grade materials for the ultimate riding experience."
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Pro Spec" },
        { "type": "text", "id": "title", "label": "Product Title", "default": "Product Title" },
        { "type": "text", "id": "spec1_label", "label": "Spec 1 Label", "default": "Range" },
        { "type": "text", "id": "spec1_value", "label": "Spec 1 Value", "default": "60mi" },
        { "type": "text", "id": "spec2_label", "label": "Spec 2 Label", "default": "Power" },
        { "type": "text", "id": "spec2_value", "label": "Spec 2 Value", "default": "750W" },
        { "type": "text", "id": "spec3_label", "label": "Spec 3 Label", "default": "Speed" },
        { "type": "text", "id": "spec3_value", "label": "Spec 3 Value", "default": "28mph" }
      ]
    }
  ],
  "presets": [{ "name": "V5 Product Listing" }]
}
{% endschema %}

<main class="max-w-[1440px] mx-auto px-6 py-[120px]">
  <header class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-12 items-end">
    <div class="md:col-span-5">
      <h2 class="text-4xl font-bold text-stone-900 uppercase tracking-tight" style="font-family: 'Space Grotesk', sans-serif;">{{ section.settings.section_title }}</h2>
    </div>
    <div class="md:col-span-7 border-l border-stone-200 pl-6">
      <p class="text-lg text-stone-600 max-w-2xl leading-relaxed" style="font-family: 'Lexend', sans-serif;">{{ section.settings.section_description }}</p>
    </div>
  </header>

  <section class="flex flex-wrap gap-4">
    {%- for block in section.blocks -%}
      {%- if block.type == 'product_card' -%}
        {%- assign product_handle = block.settings.product -%}
        {%- assign product = all_products[product_handle] -%}
        {%- assign spec1_valid = false -%}
        {%- if block.settings.spec1_label != blank or block.settings.spec1_value != blank -%}
          {%- assign spec1_valid = true -%}
        {%- endif -%}
        {%- assign spec2_valid = false -%}
        {%- if block.settings.spec2_label != blank or block.settings.spec2_value != blank -%}
          {%- assign spec2_valid = true -%}
        {%- endif -%}
        {%- assign spec3_valid = false -%}
        {%- if block.settings.spec3_label != blank or block.settings.spec3_value != blank -%}
          {%- assign spec3_valid = true -%}
        {%- endif -%}
        {%- assign valid_count = 0 -%}
        {%- if spec1_valid -%}{%- assign valid_count = valid_count | plus: 1 -%}{%- endif -%}
        {%- if spec2_valid -%}{%- assign valid_count = valid_count | plus: 1 -%}{%- endif -%}
        {%- if spec3_valid -%}{%- assign valid_count = valid_count | plus: 1 -%}{%- endif -%}
        <a href="{{ product.url }}" class="group bg-white rounded-xl border border-stone-100 p-4 transition-all duration-300 hover:shadow-xl flex flex-col basis-[calc(50%-8px)] lg:basis-[calc(25%-12px)]" {{ block.shopify_attributes }}>
          <div class="relative overflow-hidden rounded-xl bg-stone-50 mb-4 aspect-[4/3]">
            {%- if product and product != blank -%}
              {%- if product.featured_image -%}
                <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}">
              {%- else -%}
                <div class="w-full h-full flex items-center justify-center text-stone-400">Product Image</div>
              {%- endif -%}
            {%- else -%}
              <div class="w-full h-full flex items-center justify-center text-stone-400">Product Image</div>
            {%- endif -%}
            <span class="absolute top-3 left-3 bg-stone-900 text-white px-2 py-0.5 rounded-full text-xs font-bold">{{ block.settings.badge }}</span>
          </div>
          <div class="flex-grow">
            <h3 class="text-base font-bold mb-1" style="font-family: 'Space Grotesk', sans-serif;">
              {%- if block.settings.title != blank and block.settings.title != 'Product Title' -%}
                {{ block.settings.title }}
              {%- elsif product and product != blank -%}
                {{ product.title }}
              {%- else -%}
                Product Title
              {%- endif -%}
            </h3>
            <p class="text-base font-bold text-[#FFC426]" style="font-family: 'Space Grotesk', sans-serif;">
              {%- if product and product != blank -%}
                {{ product.price | money }}
              {%- else -%}
                $1,299.00
              {%- endif -%}
            </p>
          </div>
          {%- if valid_count == 3 -%}
          <div class="grid grid-cols-3 pt-4 border-t border-stone-100 mt-4">
            {%- if spec1_valid -%}
            <div class="text-center">
              <p class="text-xs text-stone-400 uppercase tracking-widest mb-0.5">{{ block.settings.spec1_label }}</p>
              <p class="text-sm font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">{{ block.settings.spec1_value }}</p>
            </div>
            {%- endif -%}
            {%- if spec2_valid -%}
            <div class="text-center">
              <p class="text-xs text-stone-400 uppercase tracking-widest mb-0.5">{{ block.settings.spec2_label }}</p>
              <p class="text-sm font-bold text-[#FFC426]" style="font-family: 'Space Grotesk', sans-serif;">{{ block.settings.spec2_value }}</p>
            </div>
            {%- endif -%}
            {%- if spec3_valid -%}
            <div class="text-center">
              <p class="text-xs text-stone-400 uppercase tracking-widest mb-0.5">{{ block.settings.spec3_label }}</p>
              <p class="text-sm font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">{{ block.settings.spec3_value }}</p>
            </div>
            {%- endif -%}
          </div>
          {%- else -%}
          <div class="grid grid-cols-{{ valid_count }} gap-2 pt-4 border-t border-stone-100 mt-4">
            {%- if spec1_valid -%}
            <div>
              <p class="text-xs text-stone-400 uppercase tracking-widest mb-0.5">{{ block.settings.spec1_label }}</p>
              <p class="text-sm font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">{{ block.settings.spec1_value }}</p>
            </div>
            {%- endif -%}
            {%- if spec2_valid -%}
            <div>
              <p class="text-xs text-stone-400 uppercase tracking-widest mb-0.5">{{ block.settings.spec2_label }}</p>
              <p class="text-sm font-bold text-[#FFC426]" style="font-family: 'Space Grotesk', sans-serif;">{{ block.settings.spec2_value }}</p>
            </div>
            {%- endif -%}
            {%- if spec3_valid -%}
            <div>
              <p class="text-xs text-stone-400 uppercase tracking-widest mb-0.5">{{ block.settings.spec3_label }}</p>
              <p class="text-sm font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">{{ block.settings.spec3_value }}</p>
            </div>
            {%- endif -%}
          </div>
          {%- endif -%}
          <button class="mt-4 w-full py-3 bg-stone-900 text-white font-bold text-xs uppercase tracking-widest rounded-lg hover:bg-[#FFC426] hover:text-stone-900 transition-colors">Add to Cart</button>
        </a>
      {%- endif -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        <div class="group bg-white rounded-xl border border-stone-100 p-4 transition-all duration-300 hover:shadow-xl flex flex-col basis-[calc(50%-8px)] lg:basis-[calc(25%-12px)]">
          <div class="relative overflow-hidden rounded-xl bg-stone-50 mb-4 aspect-[4/3]">
            <div class="w-full h-full flex items-center justify-center text-stone-400">Product {{ i }}</div>
            <span class="absolute top-3 left-3 bg-stone-900 text-white px-2 py-0.5 rounded-full text-xs font-bold">Pro Spec</span>
          </div>
          <div class="flex-grow">
            <h3 class="text-base font-bold mb-1" style="font-family: 'Space Grotesk', sans-serif;">MAXFOOT M-{{ i }}</h3>
            <p class="text-base font-bold text-[#FFC426]" style="font-family: 'Space Grotesk', sans-serif;">${{ 1299 | times: i }}.00</p>
          </div>
          <div class="flex justify-center gap-4 pt-4 border-t border-stone-100 mt-4">
            <div class="text-center">
              <p class="text-xs text-stone-400 uppercase tracking-widest mb-0.5">Range</p>
              <p class="text-sm font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">60mi</p>
            </div>
            <div class="text-center">
              <p class="text-xs text-stone-400 uppercase tracking-widest mb-0.5">Power</p>
              <p class="text-sm font-bold text-[#FFC426]" style="font-family: 'Space Grotesk', sans-serif;">750W</p>
            </div>
            <div class="text-center">
              <p class="text-xs text-stone-400 uppercase tracking-widest mb-0.5">Speed</p>
              <p class="text-sm font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">28mph</p>
            </div>
          </div>
          <button class="mt-4 w-full py-3 bg-stone-900 text-white font-bold text-xs uppercase tracking-widest rounded-lg hover:bg-[#FFC426] hover:text-stone-900 transition-colors">Add to Cart</button>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </section>
</main>

<footer class="bg-stone-50 border-t border-stone-100 py-20 mt-32">
  <div class="max-w-[1440px] mx-auto px-8 grid grid-cols-2 md:grid-cols-4 gap-12">
    <div class="col-span-2">
      <div class="text-xl font-bold text-stone-900 mb-6" style="font-family: 'Space Grotesk', sans-serif;">MAXFOOT</div>
      <p class="text-stone-500 text-sm mb-8 leading-relaxed" style="font-family: 'Lexend', sans-serif;">
        Engineered for high-performance adventure and sustainable urban mobility. Designed in the USA.
      </p>
      <div class="flex gap-4">
        <span class="material-symbols-outlined text-stone-400 hover:text-[#FFC426] transition-colors cursor-pointer">public</span>
        <span class="material-symbols-outlined text-stone-400 hover:text-[#FFC426] transition-colors cursor-pointer">share</span>
        <span class="material-symbols-outlined text-stone-400 hover:text-[#FFC426] transition-colors cursor-pointer">mail</span>
      </div>
    </div>
    <div class="flex flex-col gap-4">
      <p class="text-sm text-stone-900 font-bold uppercase tracking-widest mb-4" style="font-family: 'Space Grotesk', sans-serif;">Support</p>
      <a class="text-stone-500 text-sm hover:text-stone-900 transition-colors" href="#">Tech Specs</a>
      <a class="text-stone-500 text-sm hover:text-stone-900 transition-colors" href="#">Warranty</a>
      <a class="text-stone-500 text-sm hover:text-stone-900 transition-colors" href="#">Contact Us</a>
    </div>
    <div class="flex flex-col gap-4">
      <p class="text-sm text-stone-900 font-bold uppercase tracking-widest mb-4" style="font-family: 'Space Grotesk', sans-serif;">Company</p>
      <a class="text-stone-500 text-sm hover:text-stone-900 transition-colors" href="#">Dealer Locator</a>
      <a class="text-stone-500 text-sm hover:text-stone-900 transition-colors" href="#">Privacy Policy</a>
      <a class="text-stone-500 text-sm hover:text-stone-900 transition-colors" href="#">Terms of Service</a>
    </div>
  </div>
  <div class="max-w-[1440px] mx-auto px-8 mt-20 pt-8 border-t border-stone-100">
    <p class="text-stone-500 text-xs uppercase tracking-widest">
      © 2024 MAXFOOT ELECTRIC BIKES. ENGINEERED FOR ADVENTURE.
    </p>
  </div>
</footer>