{% schema %}
{
  "name": "V5 Product Listing",
  "tag": "section",
  "class": "maxfoot-v5-product-listing",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "MAXFOOT"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "ENGINEERED SERIES"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "Pushing the boundaries of electric mobility. Our Engineered Series combines high-performance power units with aerospace-grade materials for the ultimate riding experience."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    },
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Pro Spec"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5 Product Listing"
    }
  ]
}
{% endschema %}

<!-- Navigation -->
<nav class="bg-white border-b border-neutral-100 sticky top-0 z-50">
  <div class="flex justify-between items-center w-full px-6 py-4 max-w-[1440px] mx-auto">
    <div class="text-2xl font-black tracking-tighter text-neutral-900">{{ section.settings.brand_name }}</div>
    <div class="hidden md:flex gap-8 items-center">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_link' -%}
          <a class="text-neutral-600 font-medium text-sm tracking-widest uppercase hover:text-yellow-500 transition-colors" href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="flex items-center gap-6">
      <button class="material-symbols-outlined text-neutral-600 hover:text-yellow-500">search</button>
      <button class="material-symbols-outlined text-neutral-600 hover:text-yellow-500">shopping_cart</button>
      <button class="bg-yellow-400 text-neutral-900 px-6 py-2 rounded font-bold text-sm">Shop Now</button>
    </div>
  </div>
</nav>

<main class="max-w-[1440px] mx-auto px-6 py-[120px]">
  <header class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-12 items-end">
    <div class="md:col-span-5">
      <h2 class="text-4xl font-bold text-neutral-900 uppercase tracking-tight">{{ section.settings.section_title }}</h2>
    </div>
    <div class="md:col-span-7 border-l border-stone-200 pl-6">
      <p class="text-lg text-neutral-600 max-w-2xl">{{ section.settings.section_description }}</p>
    </div>
  </header>

  <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {%- for block in section.blocks -%}
      {%- if block.type == 'product_card' -%}
        {%- assign product = block.settings.product -%}
        <div class="group bg-white rounded-xl border border-stone-100 p-6 transition-all duration-300 hover:shadow-xl flex flex-col h-full" {{ block.shopify_attributes }}>
          <div class="relative overflow-hidden rounded-xl bg-stone-50 mb-6 aspect-[4/3]">
            {%- if product.featured_image -%}
              <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}">
            {%- else -%}
              <div class="w-full h-full flex items-center justify-center text-stone-400">Product Image</div>
            {%- endif -%}
            <span class="absolute top-4 left-4 bg-neutral-900 text-white px-3 py-1 rounded-full text-xs font-bold">{{ block.settings.badge }}</span>
          </div>
          <div class="flex-grow">
            <h3 class="text-xl font-bold mb-2">{{ product.title | default: 'Product Title' }}</h3>
            <p class="text-xl font-bold text-yellow-500">${{ product.price | default: 1299 | money_without_currency }}.00</p>
          </div>
        </div>
      {%- endif -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        <div class="group bg-white rounded-xl border border-stone-100 p-6 transition-all duration-300 hover:shadow-xl flex flex-col h-full">
          <div class="relative overflow-hidden rounded-xl bg-stone-50 mb-6 aspect-[4/3]">
            <div class="w-full h-full flex items-center justify-center text-stone-400">Product {{ i }}</div>
            <span class="absolute top-4 left-4 bg-neutral-900 text-white px-3 py-1 rounded-full text-xs font-bold">Pro Spec</span>
          </div>
          <div class="flex-grow">
            <h3 class="text-xl font-bold mb-2">MAXFOOT M-{{ i }}</h3>
            <p class="text-xl font-bold text-yellow-500">${{ 1299 | times: i }}.00</p>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </section>
</main>
