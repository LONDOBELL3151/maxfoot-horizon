{% comment %}
  Maxfoot Tech CTA Section - Technology Page
  Dark background with gradient and dual buttons
{% endcomment %}

<section
  id="MaxfootTechCTA-{{ section.id }}"
  class="maxfoot-tech-cta"
>
  <div class="maxfoot-tech-cta__gradient"></div>

  <div class="maxfoot-tech-cta__container">
    <h2 class="maxfoot-tech-cta__title">
      READY TO <span class="text-accent">REVOLUTIONIZE</span> YOUR RIDE?
    </h2>
    <p class="maxfoot-tech-cta__description">
      Experience the peak of e-bike technology. Join the frontier of exploration.
    </p>
    <div class="maxfoot-tech-cta__buttons">
      <button class="maxfoot-tech-cta__btn maxfoot-tech-cta__btn--primary">
        Build Your Machine
      </button>
      <button class="maxfoot-tech-cta__btn maxfoot-tech-cta__btn--secondary">
        Request Test Drive
      </button>
    </div>
  </div>
</section>

<style>
  .maxfoot-tech-cta {
    position: relative;
    padding: 120px 24px;
    background-color: #121414;
    text-align: center;
    overflow: hidden;
  }

  .maxfoot-tech-cta__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(255, 196, 38, 0.1), transparent);
    pointer-events: none;
  }

  .maxfoot-tech-cta__container {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }

  .maxfoot-tech-cta__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 60px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 24px 0;
  }

  .maxfoot-tech-cta__title span {
    color: #ffc426;
  }

  .maxfoot-tech-cta__description {
    font-family: 'Lexend', sans-serif;
    font-size: 20px;
    line-height: 1.6;
    color: #9a9a9a;
    max-width: 560px;
    margin: 0 auto 40px 0;
  }

  .maxfoot-tech-cta__buttons {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }

  @media screen and (min-width: 640px) {
    .maxfoot-tech-cta__buttons {
      flex-direction: row;
      justify-content: center;
    }
  }

  .maxfoot-tech-cta__btn {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 20px 48px;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .maxfoot-tech-cta__btn--primary {
    background-color: #ffc426;
    color: #1a1c1c;
    border: none;
  }

  .maxfoot-tech-cta__btn--primary:hover {
    transform: scale(1.05);
  }

  .maxfoot-tech-cta__btn--primary:active {
    transform: scale(0.95);
  }

  .maxfoot-tech-cta__btn--secondary {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .maxfoot-tech-cta__btn--secondary:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .maxfoot-tech-cta__btn--secondary:active {
    transform: scale(0.95);
  }

  @media screen and (max-width: 767px) {
    .maxfoot-tech-cta {
      padding: 64px 16px;
    }

    .maxfoot-tech-cta__title {
      font-size: 36px;
    }

    .maxfoot-tech-cta__description {
      font-size: 18px;
    }

    .maxfoot-tech-cta__btn {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Tech CTA",
  "tag": "section",
  "class": "maxfoot-tech-cta-section",
  "settings": [],
  "presets": [
    {
      "name": "Maxfoot Tech CTA"
    }
  ]
}
{% endschema %}
