{% schema %}
{
  "name": "Maxfoot V5 Blog Listing",
  "tag": "section",
  "class": "maxfoot-v5-blog-listing",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "VELOCITY"
    },
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title",
      "default": "THE JOURNAL"
    },
    {
      "type": "text",
      "id": "footer_copyright",
      "label": "Footer Copyright",
      "default": "© 2024 VELOCITY E-BIKES. BUILT FOR HIGH-PERFORMANCE ADVENTURE."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Is Active",
          "default": false
        }
      ]
    },
    {
      "type": "featured_post",
      "name": "Featured Post",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "blog_post",
      "name": "Blog Post",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "footer_link",
      "name": "Footer Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            {"value": "support", "label": "Support"},
            {"value": "company", "label": "Company"}
          ],
          "default": "support"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maxfoot V5 Blog Listing",
      "blocks": []
    }
  ]
}
{% endschema %}

{% stylesheet %}
<style>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #FFC426;
  }
  .hover-lift {
    transition: transform 0.3s ease;
  }
  .hover-lift:hover {
    transform: translateY(-4px);
  }
</style>
{% endstylesheet %}

<!-- TopNavBar -->
<header class="fixed top-0 w-full z-50 border-b border-zinc-900/10 bg-white/90 backdrop-blur-md">
  <div class="flex justify-between items-center px-8 h-20 max-w-[1440px] mx-auto">
    <div class="text-2xl font-black tracking-tighter text-zinc-900 uppercase">VELOCITY</div>
    <nav class="hidden md:flex items-center space-x-8">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_link' -%}
          <a
            class="text-zinc-500 hover:text-zinc-900 transition-colors uppercase tracking-wider text-sm font-bold {% if block.settings.is_active %}text-zinc-900 border-b-2 border-[#FFC426] pb-1{% endif %}"
            href="{{ block.settings.link_url }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.link_text }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
    <div class="flex items-center space-x-6">
      <button class="hover:opacity-80 transition-opacity"><span class="material-symbols-outlined text-zinc-900">shopping_cart</span></button>
      <button class="hover:opacity-80 transition-opacity"><span class="material-symbols-outlined text-zinc-900">person</span></button>
    </div>
  </div>
</header>

<main class="pt-32 pb-[120px] px-8 max-w-[1440px] mx-auto">
  <!-- Page Title -->
  <section class="mb-12 text-center">
    <h1 class="font-bold text-6xl md:text-7xl text-[#1a1c1c] uppercase mb-4 tracking-tight">{{ section.settings.page_title }}</h1>
    <div class="h-1 w-24 bg-[#FFC426] mx-auto"></div>
  </section>

  <!-- Featured Post -->
  {%- for block in section.blocks -%}
    {%- if block.type == 'featured_post' -%}
      <section class="mb-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 group cursor-pointer bg-white overflow-hidden">
          <div class="lg:col-span-7 overflow-hidden relative aspect-video lg:aspect-auto">
            {%- if block.settings.image -%}
              <img alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="{{ block.settings.image | image_url }}">
            {%- else -%}
              <img alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAZcCmSE0Opt-FORnyC4f7J83rQfTHBqRyJ-AffiCnMMRG0OFCM1E1GCJzI8lCSpF7Fq_Ti8OhiSTbLM-t7laMuNNw0_lQUmUUnrplOJ8cw4hqZi8qzuE9ZsxACXnU-RDvfcuPFRo-SMHpQVU54KO-BXa_bL4rx8QK7zykqgwxlG3HrpJP-NteZV16aKVcyB2cqnWy6SfbuuC9lW1qp2cxipRgUDx0aE6DRruRojETMgWdCGkYnRGQmlAyfVdWB2Xt6QXkVnizTVlLm" alt="">
            {%- endif -%}
          </div>
          <div class="lg:col-span-5 p-12 flex flex-col justify-center bg-[#f3f3f4] border border-[#d3c5ac]/10">
            <span class="inline-block px-4 py-1 bg-[#FFC426] text-[#231b00] font-label-lg mb-6 w-fit uppercase">{{ block.settings.category }}</span>
            <h2 class="font-bold text-3xl md:text-4xl text-[#1a1c1c] mb-4 leading-tight">{{ block.settings.title }}</h2>
            <p class="font-label-md text-[#5f5e5e] mb-6">{{ block.settings.date }}</p>
            <p class="text-lg text-[#4f4633] mb-8">{{ block.settings.excerpt }}</p>
            <a class="font-label-lg text-[#1a1c1c] flex items-center group/link" href="#">
              READ MORE
              <span class="material-symbols-outlined ml-2 transition-transform group-hover/link:translate-x-2">arrow_forward</span>
            </a>
          </div>
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}

  <!-- Blog Grid -->
  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-16">
    {%- for block in section.blocks -%}
      {%- if block.type == 'blog_post' -%}
        <article class="group" {{ block.shopify_attributes }}>
          <div class="overflow-hidden mb-6 aspect-[4/3] bg-zinc-100">
            {%- if block.settings.image -%}
              <img alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="{{ block.settings.image | image_url }}">
            {%- else -%}
              <img alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAcuNRtDrHNCwZx5UFWdMPka2RGwXqjvL7dYhcVg0_YyEWdwiLc7WNXVtnYJ1DpvhHqekbkBT5KGyRckgZuDMkYZ84egHoZJef_A5_6ZU-a7WeA1IZZoghU_d6cIZIvepbBMikxFE8cLthYXT474lcYq-rOP7V0_THKvtOM_46gT0ik9d81KBIZpANANU5xMHyS4NIxLXEzQAcIjCGtnzvOd52YCcfCG_gi4aGkdzZIi3eCyPpHgShDX5Tx8tWPMNfrxj5LMXM-T1uB" alt="">
            {%- endif -%}
          </div>
          <span class="inline-block px-3 py-1 bg-[#FFC426] text-[#231b00] font-label-md text-[10px] mb-4 uppercase rounded-full">{{ block.settings.category }}</span>
          <h3 class="font-headline-lg text-2xl text-[#1a1c1c] mb-3 group-hover:text-[#785a00] transition-colors">{{ block.settings.title }}</h3>
          <div class="flex flex-col gap-2">
            <p class="font-label-md text-[#5f5e5e]">{{ block.settings.date }}</p>
            <p class="text-base text-[#4f4633] line-clamp-2">{{ block.settings.excerpt }}</p>
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </section>

  <!-- Pagination -->
  <nav class="mt-24 flex justify-center items-center space-x-2">
    <a class="w-12 h-12 flex items-center justify-center border border-[#d3c5ac] hover:bg-surface-container transition-colors" href="#">
      <span class="material-symbols-outlined">chevron_left</span>
    </a>
    <a class="w-12 h-12 flex items-center justify-center bg-[#FFC426] text-[#231b00] font-label-lg font-bold" href="#">1</a>
    <a class="w-12 h-12 flex items-center justify-center border border-[#d3c5ac] hover:bg-surface-container transition-colors font-label-lg" href="#">2</a>
    <a class="w-12 h-12 flex items-center justify-center border border-[#d3c5ac] hover:bg-surface-container transition-colors font-label-lg" href="#">3</a>
    <span class="px-4 text-zinc-400">...</span>
    <a class="w-12 h-12 flex items-center justify-center border border-[#d3c5ac] hover:bg-surface-container transition-colors font-label-lg" href="#">12</a>
    <a class="w-12 h-12 flex items-center justify-center border border-[#d3c5ac] hover:bg-surface-container transition-colors" href="#">
      <span class="material-symbols-outlined">chevron_right</span>
    </a>
  </nav>
</main>

<!-- Footer -->
<footer class="bg-zinc-50 border-t border-zinc-200">
  <div class="max-w-[1440px] mx-auto py-20 px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
    <div class="flex flex-col gap-6">
      <div class="font-black text-xl uppercase tracking-tighter text-zinc-900">VELOCITY</div>
      <p class="text-xs tracking-tight text-zinc-500 leading-relaxed uppercase">
        {{ section.settings.footer_copyright }}
      </p>
    </div>

    {%- assign support_links = section.blocks | where: "type", "footer_link" | where: "settings.category", "support" -%}
    {%- assign company_links = section.blocks | where: "type", "footer_link" | where: "settings.category", "company" -%}

    {%- if support_links.size > 0 -%}
      <div class="flex flex-col gap-4">
        <h4 class="font-bold text-sm uppercase tracking-widest text-zinc-900">Support</h4>
        <ul class="flex flex-col gap-2">
          {%- for block in support_links -%}
            <li>
              <a class="text-xs text-zinc-500 hover:text-zinc-900 transition-all hover:underline decoration-[#FFC426] underline-offset-4" href="{{ block.settings.link_url }}" {{ block.shopify_attributes }}>
                {{ block.settings.link_text }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if company_links.size > 0 -%}
      <div class="flex flex-col gap-4">
        <h4 class="font-bold text-sm uppercase tracking-widest text-zinc-900">Company</h4>
        <ul class="flex flex-col gap-2">
          {%- for block in company_links -%}
            <li>
              <a class="text-xs text-zinc-500 hover:text-zinc-900 transition-all hover:underline decoration-[#FFC426] underline-offset-4" href="{{ block.settings.link_url }}" {{ block.shopify_attributes }}>
                {{ block.settings.link_text }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="flex flex-col gap-6">
      <h4 class="font-bold text-sm uppercase tracking-widest text-zinc-900">Newsletter</h4>
      <div class="relative">
        <input class="w-full bg-transparent border-b-2 border-zinc-200 py-2 text-xs focus:outline-none focus:border-[#FFC426] transition-colors" placeholder="JOIN THE LIST" type="email"/>
        <button class="absolute right-0 bottom-2">
          <span class="material-symbols-outlined text-zinc-900">arrow_forward</span>
        </button>
      </div>
    </div>
  </div>
</footer>