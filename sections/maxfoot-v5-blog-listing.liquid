{% schema %}
{
  "name": "V5 Blog Listing",
  "tag": "section",
  "class": "maxfoot-v5-blog-listing",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title",
      "default": "THE JOURNAL"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured Post Title",
      "default": "BEYOND THE ASPHALT: THE WINTER CROSSING SERIES"
    },
    {
      "type": "textarea",
      "id": "featured_excerpt",
      "label": "Featured Post Excerpt",
      "default": "Pushing the boundaries of battery efficiency and thermal management in sub-zero environments. Our engineering team takes the Maxfoot M-3 to the northern territories to prove that performance doesn't freeze when the mercury drops."
    },
    {
      "type": "text",
      "id": "featured_date",
      "label": "Featured Post Date",
      "default": "October 24, 2024"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured Post Image"
    }
  ],
  "blocks": [
    {
      "type": "blog_card",
      "name": "Blog Card",
      "settings": [
        { "type": "text", "id": "category", "label": "Category" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Article URL" }
      ]
    }
  ],
  "presets": [{ "name": "V5 Blog Listing" }]
}
{% endschema %}

<main class="pb-[120px] px-8 max-w-[1440px] mx-auto">
  <section class="mb-12 text-center">
    <h1 class="text-[72px] text-stone-900 uppercase mb-3 tracking-tight leading-none" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; letter-spacing: -0.04em;">{{ section.settings.page_title }}</h1>
    <div class="h-1 w-24 bg-[#FFC426] mx-auto"></div>
  </section>

  <section class="mb-24">
    <a href="#" class="grid grid-cols-1 lg:grid-cols-12 gap-6 group cursor-pointer bg-white overflow-hidden">
      <div class="lg:col-span-7 overflow-hidden relative aspect-video lg:aspect-auto">
        {%- if section.settings.featured_image -%}
          <img alt="Featured Post" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="{{ section.settings.featured_image | image_url: width: 800 }}">
        {%- else -%}
          <img alt="Featured Post" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAZcCmSE0Opt-FORnyC4f7J83rQfTHBqRyJ-AffiCnMMRG0OFCM1E1GCJzI8lCSpF7Fq_Ti8OhiSTbLM-t7laMuNNw0_lQUmUUnrplOJ8cw4hqZi8qzuE9ZsxACXnU-RDvfcuPFRo-SMHpQVU54KO-BXa_bL4rx8QK7zykqgwxlG3HrpJP-NteZV16aKVcyB2cqnWy6SfbuuC9lW1qp2cxipRgUDx0aE6DRruRojETMgWdCGkYnRGQmlAyfVdWB2Xt6QXkVnizTVlLm">
        {%- endif -%}
      </div>
      <div class="lg:col-span-5 p-12 flex flex-col justify-center bg-stone-50 border border-stone-100">
        <span class="inline-block px-4 py-1 bg-[#FFC426] text-stone-900 text-sm uppercase mb-6 w-fit font-bold" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; letter-spacing: 0.1em;">ADVENTURE</span>
        <h2 class="text-[48px] text-stone-900 mb-4 leading-tight" style="font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.02em;">{{ section.settings.featured_title }}</h2>
        <p class="text-[12px] text-stone-500 mb-6 uppercase" style="font-family: 'Space Grotesk', sans-serif; font-weight: 500; letter-spacing: 0.1em;">{{ section.settings.featured_date }}</p>
        <p class="text-[18px] text-stone-600 mb-8 leading-relaxed" style="font-family: 'Lexend', sans-serif;">{{ section.settings.featured_excerpt }}</p>
        <span class="text-sm text-stone-900 flex items-center group-hover:text-[#FFC426] transition-colors font-bold uppercase tracking-widest" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; letter-spacing: 0.1em;">
          READ MORE
          <span class="material-symbols-outlined ml-2 transition-transform group-hover:translate-x-2">arrow_forward</span>
        </span>
      </div>
    </a>
  </section>

  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 gap-y-16">
    {%- for block in section.blocks -%}
      {%- if block.type == 'blog_card' -%}
        <article class="group">
          <a href="{{ block.settings.link }}" class="block">
            <div class="overflow-hidden mb-6 aspect-[4/3] bg-stone-100 rounded-xl">
              {%- if block.settings.image -%}
                <img alt="{{ block.settings.title }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="{{ block.settings.image | image_url: width: 400 }}">
              {%- else -%}
                <img alt="{{ block.settings.title }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAcuNRtDrHNCwZx5UFWdMPka2RGwXqjvL7dYhcVg0_YyEWdwiLc7WNXVtnYJ1DpvhHqekbkBT5KGyRckgZuDMkYZ84egHoZJef_A5_6ZU-a7WeA1IZZoghU_d6cIZIvepbBMikxFE8cLthYXT474lcYq-rOP7V0_THKvtOM_46gT0ik9d81KBIZpANANU5xMHyS4NIxLXEzQAcIjCGtnzvOd52YCcfCG_gi4aGkdzZIi3eCyPpHgShDX5Tx8tWPMNfrxj5LMXM-T1uB">
              {%- endif -%}
            </div>
            <span class="inline-block px-3 py-1 bg-[#FFC426] text-stone-900 text-[10px] mb-4 uppercase rounded-full font-bold" style="font-family: 'Space Grotesk', sans-serif; font-weight: 500;">{{ block.settings.category }}</span>
            <h3 class="text-[32px] text-stone-900 mb-3 group-hover:text-[#FFC426] transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-weight: 600; line-height: 1.3;">{{ block.settings.title }}</h3>
            <div class="flex flex-col gap-2">
              <p class="text-[12px] text-stone-400 uppercase" style="font-family: 'Space Grotesk', sans-serif; font-weight: 500; letter-spacing: 0.1em;">{{ block.settings.date }}</p>
              <p class="text-[16px] text-stone-500 line-clamp-2 leading-relaxed" style="font-family: 'Lexend', sans-serif;">{{ block.settings.excerpt }}</p>
            </div>
          </a>
        </article>
      {%- endif -%}
    {%- else -%}
      <article class="group">
        <div class="overflow-hidden mb-6 aspect-[4/3] bg-stone-100 rounded-xl">
          <img alt="Blog Post" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAcuNRtDrHNCwZx5UFWdMPka2RGwXqjvL7dYhcVg0_YyEWdwiLc7WNXVtnYJ1DpvhHqekbkBT5KGyRckgZuDMkYZ84egHoZJef_A5_6ZU-a7WeA1IZZoghU_d6cIZIvepbBMikxFE8cLthYXT474lcYq-rOP7V0_THKvtOM_46gT0ik9d81KBIZpANANU5xMHyS4NIxLXEzQAcIjCGtnzvOd52YCcfCG_gi4aGkdzZIi3eCyPpHgShDX5Tx8tWPMNfrxj5LMXM-T1uB">
        </div>
        <span class="inline-block px-3 py-1 bg-[#FFC426] text-stone-900 text-[10px] mb-4 uppercase rounded-full font-bold">TECH</span>
        <h3 class="text-[32px] text-stone-900 mb-3 group-hover:text-[#FFC426] transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-weight: 600; line-height: 1.3;">The Science of High-Torque Hub Motors</h3>
        <div class="flex flex-col gap-2">
          <p class="text-[12px] text-stone-400 uppercase" style="font-family: 'Space Grotesk', sans-serif; font-weight: 500; letter-spacing: 0.1em;">February 28, 2024</p>
          <p class="text-[16px] text-stone-500 line-clamp-2 leading-relaxed" style="font-family: 'Lexend', sans-serif;">A deep dive into the engineering behind our 750W brushless motor.</p>
        </div>
      </article>
      <article class="group">
        <div class="overflow-hidden mb-6 aspect-[4/3] bg-stone-100 rounded-xl">
          <img alt="Blog Post" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCcTkbW5M_IWlWhJFELJWf23UX3TsevPVIVl8UuehZs2HsBuj6JLRvVFEqPUbONopYjelCWvHHZB2xGkFhq9cLPzDn_QqRZgQg2c56GujFNdEDf62Bih3Gqxt1VebAMZ8wqqnSGfr9LPZLgiWfVz0nE6EF3f1ggGAafnPymJmGlbJVFElaVPSZqXMRPApcITJa04o4hq9SKLYyr11t4u95ZzAFWgStUaYhcE98pk19MfSQYm7tS8UBzSn1aAsJ2Db0Ks2df2hpEIE-Q">
        </div>
        <span class="inline-block px-3 py-1 bg-[#FFC426] text-stone-900 text-[10px] mb-4 uppercase rounded-full font-bold">LIFESTYLE</span>
        <h3 class="text-[32px] text-stone-900 mb-3 group-hover:text-[#FFC426] transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-weight: 600; line-height: 1.3;">Urban Mobility: The Future is Electric</h3>
        <div class="flex flex-col gap-2">
          <p class="text-[12px] text-stone-400 uppercase" style="font-family: 'Space Grotesk', sans-serif; font-weight: 500; letter-spacing: 0.1em;">January 12, 2024</p>
          <p class="text-[16px] text-stone-500 line-clamp-2 leading-relaxed" style="font-family: 'Lexend', sans-serif;">How electric bikes are reshaping city transportation.</p>
        </div>
      </article>
      <article class="group">
        <div class="overflow-hidden mb-6 aspect-[4/3] bg-stone-100 rounded-xl">
          <img alt="Blog Post" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAiSyO2pVwz8uFONt4CIw-v79qEz-xHLmufsjQ3ZlcI2-t_ppJo2lwT8L8-CEGTHvNmbBvkTXY_vqGVWQY4Vmd71Vyj-IpknFeHitCcHL4PsNJ4At8Cl0EK7sNt95rHAKqHQXqbUta2QcqEu6rnJqmKcuzCHXqfwOAyten-odTNtoQKbek5BKcNnqj3U191G0xiuleSGK2vC5WnCsg1oEkuAoIT9R1j_lQuU-vg51PshJgIn1QBnK3U_0i7Y8vq7hJatL8MMnBYqepy">
        </div>
        <span class="inline-block px-3 py-1 bg-[#FFC426] text-stone-900 text-[10px] mb-4 uppercase rounded-full font-bold">ADVENTURE</span>
        <h3 class="text-[32px] text-stone-900 mb-3 group-hover:text-[#FFC426] transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-weight: 600; line-height: 1.3;">Conquering the High Sierras with the M-3</h3>
        <div class="flex flex-col gap-2">
          <p class="text-[12px] text-stone-400 uppercase" style="font-family: 'Space Grotesk', sans-serif; font-weight: 500; letter-spacing: 0.1em;">March 15, 2024</p>
          <p class="text-[16px] text-stone-500 line-clamp-2 leading-relaxed" style="font-family: 'Lexend', sans-serif;">Discover how our latest fat-tire model handled rugged terrain.</p>
        </div>
      </article>
    {%- endfor -%}
  </section>

  <nav class="mt-24 flex justify-center items-center space-x-2">
    <a class="w-12 h-12 flex items-center justify-center border border-stone-200 hover:bg-stone-100 transition-colors" href="#">
      <span class="material-symbols-outlined">chevron_left</span>
    </a>
    <a class="w-12 h-12 flex items-center justify-center bg-[#FFC426] text-stone-900 font-bold" href="#">1</a>
    <a class="w-12 h-12 flex items-center justify-center border border-stone-200 hover:bg-stone-100 transition-colors text-sm" href="#">2</a>
    <a class="w-12 h-12 flex items-center justify-center border border-stone-200 hover:bg-stone-100 transition-colors text-sm" href="#">3</a>
    <span class="px-4 text-stone-400">...</span>
    <a class="w-12 h-12 flex items-center justify-center border border-stone-200 hover:bg-stone-100 transition-colors text-sm" href="#">12</a>
    <a class="w-12 h-12 flex items-center justify-center border border-stone-200 hover:bg-stone-100 transition-colors" href="#">
      <span class="material-symbols-outlined">chevron_right</span>
    </a>
  </nav>
</main>

<footer class="bg-stone-50 border-t border-stone-200">
  <div class="max-w-[1440px] mx-auto py-20 px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
    <div class="flex flex-col gap-6">
      <div class="font-black text-xl uppercase tracking-tighter text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">{{ section.settings.brand_name }}</div>
      <p class="text-xs tracking-tight text-stone-500 leading-relaxed uppercase" style="font-family: 'Space Grotesk', sans-serif;">
        © 2024 MAXFOOT ELECTRIC BIKES.<br/>BUILT FOR HIGH-PERFORMANCE ADVENTURE.
      </p>
    </div>
    <div class="flex flex-col gap-4">
      <h4 class="font-bold text-sm uppercase tracking-widest text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">Support</h4>
      <ul class="flex flex-col gap-2">
        <li><a class="text-xs text-stone-500 hover:text-[#FFC426] transition-all" href="#">Dealer Locator</a></li>
        <li><a class="text-xs text-stone-500 hover:text-[#FFC426] transition-all" href="#">Manuals</a></li>
        <li><a class="text-xs text-stone-500 hover:text-[#FFC426] transition-all" href="#">Warranty</a></li>
      </ul>
    </div>
    <div class="flex flex-col gap-4">
      <h4 class="font-bold text-sm uppercase tracking-widest text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">Company</h4>
      <ul class="flex flex-col gap-2">
        <li><a class="text-xs text-stone-500 hover:text-[#FFC426] transition-all" href="#">Sustainability</a></li>
        <li><a class="text-xs text-stone-500 hover:text-[#FFC426] transition-all" href="#">Journal</a></li>
        <li><a class="text-xs text-stone-500 hover:text-[#FFC426] transition-all" href="#">About</a></li>
      </ul>
    </div>
    <div class="flex flex-col gap-6">
      <h4 class="font-bold text-sm uppercase tracking-widest text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">Newsletter</h4>
      <div class="relative">
        <input class="w-full bg-transparent border-b-2 border-stone-200 py-2 text-xs focus:outline-none focus:border-[#FFC426] transition-colors placeholder-stone-400" placeholder="JOIN THE LIST" type="email" style="font-family: 'Space Grotesk', sans-serif;">
        <button class="absolute right-0 bottom-2">
          <span class="material-symbols-outlined text-stone-900">arrow_forward</span>
        </button>
      </div>
    </div>
  </div>
</footer>