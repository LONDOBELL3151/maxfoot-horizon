{% schema %}
{
  "name": "V5 Blog Listing",
  "tag": "section",
  "class": "maxfoot-v5-blog-listing",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "VELOCITY"
    },
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title",
      "default": "THE JOURNAL"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured Post Title",
      "default": "BEYOND THE ASPHALT: THE WINTER CROSSING SERIES"
    },
    {
      "type": "textarea",
      "id": "featured_excerpt",
      "label": "Featured Post Excerpt",
      "default": "Pushing the boundaries of battery efficiency and thermal management in sub-zero environments. Our engineering team takes the Velocity X-1 to the northern territories to prove that performance doesn't freeze when the mercury drops."
    },
    {
      "type": "text",
      "id": "featured_date",
      "label": "Featured Post Date",
      "default": "October 24, 2024"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Nav Link",
      "settings": [
        { "type": "text", "id": "link_text", "label": "Link Text" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    },
    {
      "type": "blog_card",
      "name": "Blog Card",
      "settings": [
        { "type": "text", "id": "category", "label": "Category" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Article URL" }
      ]
    }
  ],
  "presets": [{ "name": "V5 Blog Listing" }]
}
{% endschema %}

<style>
.material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    vertical-align: middle;
}
.custom-scrollbar::-webkit-scrollbar {
    width: 4px;
}
.custom-scrollbar::-webkit-scrollbar-thumb {
    background: #FFC426;
}
.hover-lift {
    transition: transform 0.3s ease;
}
.hover-lift:hover {
    transform: translateY(-4px);
}
</style>

<!-- TopNavBar -->
<header class="fixed top-0 w-full z-50 border-b border-zinc-900/10 bg-white/90 backdrop-blur-md">
<div class="flex justify-between items-center px-8 h-20 max-w-[1440px] mx-auto">
<div class="text-2xl font-black tracking-tighter text-zinc-900 uppercase">{{ section.settings.brand_name }}</div>
<nav class="hidden md:flex items-center space-x-8">
  {%- for block in section.blocks -%}{%- if block.type == 'nav_link' -%}<a class="text-zinc-500 hover:text-zinc-900 transition-colors uppercase tracking-wider text-sm font-bold" href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a>{%- endif -%}{%- endfor -%}
</nav>
<div class="flex items-center space-x-6">
<button class="hover:opacity-80 transition-opacity"><span class="material-symbols-outlined text-zinc-900">shopping_cart</span></button>
<button class="hover:opacity-80 transition-opacity"><span class="material-symbols-outlined text-zinc-900">person</span></button>
</div>
</div>
</header>

<main class="pt-32 pb-[120px] px-8 max-w-[1440px] mx-auto">
<!-- Page Title -->
<section class="mb-12 text-center">
<h1 class="font-display-lg text-[72px] text-on-surface uppercase mb-3 tracking-tight leading-none" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; letter-spacing: -0.04em;">{{ section.settings.page_title }}</h1>
<div class="h-1 w-24 bg-primary-container mx-auto"></div>
</section>

<!-- Featured Post -->
<section class="mb-24">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 group cursor-pointer bg-white overflow-hidden">
<div class="lg:col-span-7 overflow-hidden relative aspect-video lg:aspect-auto">
<img alt="Featured Post" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAZcCmSE0Opt-FORnyC4f7J83rQfTHBqRyJ-AffiCnMMRG0OFCM1E1GCJzI8lCSpF7Fq_Ti8OhiSTbLM-t7laMuNNw0_lQUmUUnrplOJ8cw4hqZi8qzuE9ZsxACXnU-RDvfcuPFRo-SMHpQVU54KO-BXa_bL4rx8QK7zykqgwxlG3HrpJP-NteZV16aKVcyB2cqnWy6SfbuuC9lW1qp2cxipRgUDx0aE6DRruRojETMgWdCGkYnRGQmlAyfVdWB2Xt6QXkVnizTVlLm"/>
</div>
<div class="lg:col-span-5 p-12 flex flex-col justify-center bg-surface-container-low border border-outline-variant/10">
<span class="inline-block px-4 py-1 bg-primary-container text-on-tertiary-fixed text-sm uppercase mb-6 w-fit" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; letter-spacing: 0.1em;">ADVENTURE</span>
<h2 class="text-[48px] text-on-surface mb-4 leading-tight" style="font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.02em;">{{ section.settings.featured_title }}</h2>
<p class="text-[12px] text-secondary mb-6 uppercase" style="font-family: 'Space Grotesk', sans-serif; font-weight: 500; letter-spacing: 0.1em;">{{ section.settings.featured_date }}</p>
<p class="text-[18px] text-on-surface-variant mb-8 leading-relaxed" style="font-family: 'Lexend', sans-serif;">{{ section.settings.featured_excerpt }}</p>
<a class="text-sm text-on-surface flex items-center group/link uppercase" href="#" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; letter-spacing: 0.1em;">
    READ MORE
    <span class="material-symbols-outlined ml-2 transition-transform group-hover/link:translate-x-2">arrow_forward</span>
</a>
</div>
</div>
</section>

<!-- Blog Grid -->
<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 gap-y-16">
{%- for block in section.blocks -%}{%- if block.type == 'blog_card' -%}
<article class="group">
<div class="overflow-hidden mb-6 aspect-[4/3] bg-zinc-100">
{%- if block.settings.image -%}
<img alt="{{ block.settings.title }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="{{ block.settings.image | image_url: width: 400 }}"/>
{%- else -%}
<img alt="{{ block.settings.title }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAcuNRtDrHNCwZx5UFWdMPka2RGwXqjvL7dYhcVg0_YyEWdwiLc7WNXVtnYJ1DpvhHqekbkBT5KGyRckgZuDMkYZ84egHoZJef_A5_6ZU-a7WeA1IZZoghU_d6cIZIvepbBMikxFE8cLthYXT474lcYq-rOP7V0_THKvtOM_46gT0ik9d81KBIZpANANU5xMHyS4NIxLXEzQAcIjCGtnzvOd52YCcfCG_gi4aGkdzZIi3eCyPpHgShDX5Tx8tWPMNfrxj5LMXM-T1uB"/>
{%- endif -%}
</div>
<span class="inline-block px-3 py-1 bg-primary-container text-on-tertiary-fixed text-[10px] mb-4 uppercase rounded-full" style="font-family: 'Space Grotesk', sans-serif; font-weight: 500;">{{ block.settings.category }}</span>
<h3 class="text-[32px] text-on-surface mb-3 group-hover:text-primary transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-weight: 600; line-height: 1.3;">{{ block.settings.title }}</h3>
<div class="flex flex-col gap-2">
<p class="text-[12px] text-secondary uppercase" style="font-family: 'Space Grotesk', sans-serif; font-weight: 500; letter-spacing: 0.1em;">{{ block.settings.date }}</p>
<p class="text-[16px] text-on-surface-variant line-clamp-2 leading-relaxed" style="font-family: 'Lexend', sans-serif;">{{ block.settings.excerpt }}</p>
</div>
</article>
{%- endif -%}{%- endfor -%}
</section>

<!-- Pagination -->
<nav class="mt-24 flex justify-center items-center space-x-2">
<a class="w-12 h-12 flex items-center justify-center border border-outline-variant hover:bg-surface-container transition-colors" href="#">
<span class="material-symbols-outlined">chevron_left</span>
</a>
<a class="w-12 h-12 flex items-center justify-center bg-primary-container text-on-tertiary-fixed font-bold" href="#">1</a>
<a class="w-12 h-12 flex items-center justify-center border border-outline-variant hover:bg-surface-container transition-colors text-sm" href="#">2</a>
<a class="w-12 h-12 flex items-center justify-center border border-outline-variant hover:bg-surface-container transition-colors text-sm" href="#">3</a>
<span class="px-4 text-zinc-400">...</span>
<a class="w-12 h-12 flex items-center justify-center border border-outline-variant hover:bg-surface-container transition-colors text-sm" href="#">12</a>
<a class="w-12 h-12 flex items-center justify-center border border-outline-variant hover:bg-surface-container transition-colors" href="#">
<span class="material-symbols-outlined">chevron_right</span>
</a>
</nav>
</main>

<!-- Footer -->
<footer class="bg-zinc-50 border-t border-zinc-200">
<div class="max-w-[1440px] mx-auto py-20 px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
<div class="flex flex-col gap-6">
<div class="font-black text-xl uppercase tracking-tighter text-zinc-900" style="font-family: 'Space Grotesk', sans-serif;">{{ section.settings.brand_name }}</div>
<p class="text-xs tracking-tight text-zinc-500 leading-relaxed uppercase" style="font-family: 'Space Grotesk', sans-serif;">
    © 2024 VELOCITY E-BIKES.<br/>BUILT FOR HIGH-PERFORMANCE ADVENTURE.
</p>
</div>
<div class="flex flex-col gap-4">
<h4 class="font-bold text-sm uppercase tracking-widest text-zinc-900" style="font-family: 'Space Grotesk', sans-serif;">Support</h4>
<ul class="flex flex-col gap-2">
<li><a class="text-xs text-zinc-500 hover:text-zinc-900 transition-all hover:underline decoration-[#FFC426] underline-offset-4" href="#">Dealer Locator</a></li>
<li><a class="text-xs text-zinc-500 hover:text-zinc-900 transition-all hover:underline decoration-[#FFC426] underline-offset-4" href="#">Manuals</a></li>
<li><a class="text-xs text-zinc-500 hover:text-zinc-900 transition-all hover:underline decoration-[#FFC426] underline-offset-4" href="#">Warranty</a></li>
</ul>
</div>
<div class="flex flex-col gap-4">
<h4 class="font-bold text-sm uppercase tracking-widest text-zinc-900" style="font-family: 'Space Grotesk', sans-serif;">Company</h4>
<ul class="flex flex-col gap-2">
<li><a class="text-xs text-zinc-500 hover:text-zinc-900 transition-all hover:underline decoration-[#FFC426] underline-offset-4" href="#">Sustainability</a></li>
<li><a class="text-xs text-zinc-500 hover:text-zinc-900 transition-all hover:underline decoration-[#FFC426] underline-offset-4" href="#">Journal</a></li>
<li><a class="text-xs text-zinc-500 hover:text-zinc-900 transition-all hover:underline decoration-[#FFC426] underline-offset-4" href="#">About</a></li>
</ul>
</div>
<div class="flex flex-col gap-6">
<h4 class="font-bold text-sm uppercase tracking-widest text-zinc-900" style="font-family: 'Space Grotesk', sans-serif;">Newsletter</h4>
<div class="relative">
<input class="w-full bg-transparent border-b-2 border-zinc-200 py-2 text-xs focus:outline-none focus:border-[#FFC426] transition-colors" placeholder="JOIN THE LIST" type="email" style="font-family: 'Space Grotesk', sans-serif;"/>
<button class="absolute right-0 bottom-2">
<span class="material-symbols-outlined text-zinc-900">arrow_forward</span>
</button>
</div>
</div>
</div>
</footer>