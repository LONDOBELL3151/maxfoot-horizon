{% comment %}
  Maxfoot Core Innovations Section - Technology Page
  Bento grid layout showcasing key technical innovations
{% endcomment %}

<section
  id="MaxfootCoreInnovations-{{ section.id }}"
  class="maxfoot-core-innovations"
>
  <div class="maxfoot-core-innovations__terrain-pattern"></div>

  <div class="maxfoot-core-innovations__container">
    <h2 class="maxfoot-core-innovations__title">CORE INNOVATIONS</h2>

    <div class="maxfoot-core-innovations__grid">
      <div class="maxfoot-innovation-card maxfoot-innovation-card--large">
        <div class="maxfoot-innovation-card__bg-icon">
          <svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.67 4H14V2h-4v2H8.33C7.6 4 7 4.6 7 5.33v15.33C7 21.4 7.6 22 8.33 22h7.33c.74 0 1.34-.6 1.34-1.33V5.33C17 4.6 16.4 4 15.67 4zM11 20v-5.5H9L13 7v5.5h2L11 20z"/>
          </svg>
        </div>
        <div class="maxfoot-innovation-card__content">
          <span class="maxfoot-innovation-card__label">Power Cell v4</span>
          <h3 class="maxfoot-innovation-card__heading">
            CRYOGENIC <br/> THERMAL <br/> SHIELDING
          </h3>
          <p class="maxfoot-innovation-card__description">
            Aerospace-grade insulation maintaining peak voltage in temperatures as low as -20°C.
          </p>
        </div>
        <div class="maxfoot-innovation-card__cta">
          <span>Explore Thermal Engineering</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
          </svg>
        </div>
      </div>

      <div class="maxfoot-innovation-card maxfoot-innovation-card--medium">
        <div class="maxfoot-innovation-card__header">
          <div>
            <h3 class="maxfoot-innovation-card__subheading">HYDRO-FORMED EXO-SHELL</h3>
            <p class="maxfoot-innovation-card__subdesc">Single-piece aluminum chassis with integrated wire routing.</p>
          </div>
          <div class="maxfoot-innovation-card__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L2 7v10l10 5 10-5V7L12 2zm0 2.18l6.9 3.45L12 11.09 5.1 7.63 12 4.18zM4 8.82l7 3.5v7.36l-7-3.5V8.82zm9 10.86v-7.36l7-3.5v7.36l-7 3.5z"/>
            </svg>
          </div>
        </div>
        <div class="maxfoot-innovation-card__progress-track">
          <div class="maxfoot-innovation-card__progress-fill"></div>
        </div>
      </div>

      <div class="maxfoot-innovation-card maxfoot-innovation-card--small">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
        </svg>
        <span class="maxfoot-innovation-card__small-label">E-ABS System</span>
      </div>

      <div class="maxfoot-innovation-card maxfoot-innovation-card--wide">
        <div class="maxfoot-innovation-card__diagonal"></div>
        <div class="maxfoot-innovation-card__label">Smart Sync</div>
        <h4 class="maxfoot-innovation-card__title">Biometric Unlock & Cloud Diags</h4>
      </div>
    </div>
  </div>
</section>

<style>
  .maxfoot-core-innovations {
    position: relative;
    padding: 100px 48px;
    background-color: #F8F8F8;
    overflow: hidden;
  }

  .maxfoot-core-innovations__terrain-pattern {
    display: none;
  }

  .maxfoot-core-innovations__container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
  }

  .maxfoot-core-innovations__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #121212;
    text-align: center;
    margin: 0 0 48px 0;
  }

  .maxfoot-core-innovations__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(2, minmax(180px, auto));
    gap: 16px;
  }

  .maxfoot-innovation-card {
    background-color: #FFFFFF;
    border: 1px solid #e5e5e5;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .maxfoot-innovation-card:hover {
    border-color: #ffc426;
  }

  .maxfoot-innovation-card--large {
    grid-column: span 3;
    grid-row: span 2;
  }

  .maxfoot-innovation-card--medium {
    grid-column: span 3;
  }

  .maxfoot-innovation-card--small {
    grid-column: span 2;
    align-items: center;
    text-align: center;
    gap: 12px;
    padding: 20px;
  }

  .maxfoot-innovation-card--small:hover {
    background-color: #ffc426;
  }

  .maxfoot-innovation-card--small svg {
    color: #ffc426;
  }

  .maxfoot-innovation-card--small:hover svg {
    color: #121212;
  }

  .maxfoot-innovation-card--small .maxfoot-innovation-card__small-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #121212;
  }

  .maxfoot-innovation-card--wide {
    grid-column: span 2;
    position: relative;
  }

  .maxfoot-innovation-card__bg-icon {
    position: absolute;
    top: 0;
    right: 0;
    width: 100px;
    height: 100px;
    opacity: 0.1;
    color: #ffc426;
  }

  .maxfoot-innovation-card__content {
    position: relative;
    z-index: 1;
  }

  .maxfoot-innovation-card__label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #ffc426;
    margin-bottom: 12px;
    display: block;
  }

  .maxfoot-innovation-card__heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #121212;
    margin: 0 0 12px 0;
  }

  .maxfoot-innovation-card__description {
    font-family: 'Lexend', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #6b6b6b;
    max-width: 360px;
    margin: 0;
  }

  .maxfoot-innovation-card__cta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .maxfoot-innovation-card:hover .maxfoot-innovation-card__cta {
    transform: translateX(4px);
  }

  .maxfoot-innovation-card__cta span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffc426;
  }

  .maxfoot-innovation-card__cta svg {
    color: #ffc426;
  }

  .maxfoot-innovation-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .maxfoot-innovation-card__subheading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #121212;
    margin: 0 0 6px 0;
  }

  .maxfoot-innovation-card__subdesc {
    font-family: 'Lexend', sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: #6b6b6b;
    margin: 0;
  }

  .maxfoot-innovation-card__icon {
    color: #ffc426;
  }

  .maxfoot-innovation-card__progress-track {
    height: 4px;
    background-color: #e5e5e5;
    overflow: hidden;
    border-radius: 2px;
  }

  .maxfoot-innovation-card__progress-fill {
    height: 100%;
    width: 33%;
    background-color: #ffc426;
    transition: width 0.5s ease;
    border-radius: 2px;
  }

  .maxfoot-innovation-card:hover .maxfoot-innovation-card__progress-fill {
    width: 100%;
  }

  .maxfoot-innovation-card__diagonal {
    display: none;
  }

  .maxfoot-innovation-card__label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffc426;
    margin-bottom: 6px;
  }

  .maxfoot-innovation-card__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    color: #121212;
    margin: 0;
  }

  @media screen and (max-width: 1023px) {
    .maxfoot-core-innovations__grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .maxfoot-innovation-card--large,
    .maxfoot-innovation-card--medium,
    .maxfoot-innovation-card--small,
    .maxfoot-innovation-card--wide {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  @media screen and (max-width: 767px) {
    .maxfoot-core-innovations {
      padding: 64px 16px;
    }

    .maxfoot-core-innovations__title {
      font-size: 40px;
    }

    .maxfoot-innovation-card__heading {
      font-size: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Core Innovations",
  "tag": "section",
  "class": "maxfoot-core-innovations-section",
  "settings": [],
  "presets": [
    {
      "name": "Maxfoot Core Innovations"
    }
  ]
}
{% endschema %}
