{% comment %}
  Maxfoot Support Categories Section - Support & Service Page
  4-card bento grid: Assembly, Manuals, Warranty, Shipping
{% endcomment %}

<section
  id="MaxfootSupportCategories-{{ section.id }}"
  class="maxfoot-support-categories"
>
  <div class="maxfoot-support-categories__grid">
    {% assign categories = 'Assembly|build,Manuals|menu_book,Warranty|verified_user,Shipping|local_shipping' | split: ',' %}
    {% for category in categories %}
      {% assign parts = category | split: '|' %}
      {% assign title = parts[0] %}
      {% assign icon = parts[1] %}
            {% assign descriptions = "Step-by-step unboxing and assembly videos for all models.|Download PDF owner's manuals and display instructions.|Review coverage details and submit a warranty claim.|Track your order and view shipping policies and timelines." | split: '|' %} and view shipping policies and timelines.' | split: '|' %}
      {% assign desc = descriptions[forloop.index0] %}

      <a href="#" class="maxfoot-support-card">
        <div class="maxfoot-support-card__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            {% case icon %}
              {% when 'build' %}
                <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
              {% when 'menu_book' %}
                <path d="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"/>
              {% when 'verified_user' %}
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
              {% when 'local_shipping' %}
                <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
            {% endcase %}
          </svg>
        </div>
        <h3 class="maxfoot-support-card__title">{{ title }}</h3>
        <p class="maxfoot-support-card__description">{{ desc }}</p>
      </a>
    {% endfor %}
  </div>
</section>

<style>
  .maxfoot-support-categories {
    padding: 48px 0 120px;
  }

  .maxfoot-support-categories__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 1023px) {
    .maxfoot-support-categories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 639px) {
    .maxfoot-support-categories__grid {
      grid-template-columns: 1fr;
    }
  }

  .maxfoot-support-card {
    display: block;
    background-color: #1a1c1c;
    padding: 24px;
    border-radius: 8px;
    border: 1px solid transparent;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .maxfoot-support-card:hover {
    border-color: #00D4FF;
    box-shadow: 0 0 15px rgba(0, 212, 255, 0.3);
  }

  .maxfoot-support-card__icon {
    width: 48px;
    height: 48px;
    background-color: #2f3131;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: #00D4FF;
  }

  .maxfoot-support-card__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.3;
    color: #ffffff;
    margin: 0 0 8px 0;
    transition: color 0.3s ease;
  }

  .maxfoot-support-card:hover .maxfoot-support-card__title {
    color: #00D4FF;
  }

  .maxfoot-support-card__description {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: #9a9a9a;
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    .maxfoot-support-categories {
      padding: 32px 0 64px;
    }
  }
</style>

{% schema %}
{
  "name": "Support Categories",
  "tag": "section",
  "class": "maxfoot-support-categories-section",
  "settings": [],
  "presets": [
    {
      "name": "Maxfoot Support Categories"
    }
  ]
}
{% endschema %}
