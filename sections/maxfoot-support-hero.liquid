{% comment %}
  Maxfoot Support Hero Section - Support & Service Page
  Search hero with light ice background
{% endcomment %}

<section
  id="MaxfootSupportHero-{{ section.id }}"
  class="maxfoot-support-hero"
>
  <div class="maxfoot-support-hero__container">
    <h1 class="maxfoot-support-hero__title">How can we help?</h1>
    <p class="maxfoot-support-hero__description">
      Find manuals, assembly guides, warranty information, and troubleshooting tips for your Maxfoot electric bike.
    </p>
    <div class="maxfoot-support-hero__search">
      <svg class="maxfoot-support-hero__search-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
      </svg>
      <input
        type="text"
        class="maxfoot-support-hero__search-input"
        placeholder="Search FAQs, issues, or model names..."
      />
    </div>
  </div>
</section>

<style>
  .maxfoot-support-hero {
    background-color: #E8F4F8;
    padding: 80px 24px 48px;
    margin: 0 -24px;
    border-radius: 0 0 16px 16px;
  }

  .maxfoot-support-hero__container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .maxfoot-support-hero__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 72px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #1a1c1c;
    margin: 0 0 12px 0;
  }

  .maxfoot-support-hero__description {
    font-family: 'Lexend', sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: #656464;
    max-width: 560px;
    margin: 0 auto 48px 0;
  }

  .maxfoot-support-hero__search {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
  }

  .maxfoot-support-hero__search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: #9a9a9a;
    pointer-events: none;
  }

  .maxfoot-support-hero__search-input {
    width: 100%;
    font-family: 'Lexend', sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: #1a1c1c;
    background-color: #ffffff;
    border: none;
    border-bottom: 2px solid #e2e2e2;
    padding: 16px 16px 16px 56px;
    outline: none;
    transition: border-color 0.3s ease;
    border-radius: 4px 4px 0 0;
  }

  .maxfoot-support-hero__search-input::placeholder {
    color: #9a9a9a;
  }

  .maxfoot-support-hero__search-input:focus {
    border-bottom-color: #00D4FF;
  }

  @media screen and (max-width: 767px) {
    .maxfoot-support-hero {
      padding: 64px 16px 32px;
      margin: 0 -16px;
    }

    .maxfoot-support-hero__title {
      font-size: 48px;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Support Hero",
  "tag": "section",
  "class": "maxfoot-support-hero-section",
  "settings": [],
  "presets": [
    {
      "name": "Maxfoot Support Hero"
    }
  ]
}
{% endschema %}
