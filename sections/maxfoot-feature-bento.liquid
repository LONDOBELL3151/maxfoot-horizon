{% comment %}
  Maxfoot Feature Bento Section - Product Detail Page
  Bento grid layout showcasing product features with image cards
  Light background section for visual rhythm contrast
{% endcomment %}

<section
  id="MaxfootFeatureBento-{{ section.id }}"
  class="maxfoot-feature-bento"
>
  <div class="maxfoot-feature-bento__container">
    <div class="maxfoot-feature-bento__grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'feature_card' %}
            <div
              class="maxfoot-feature-bento__card maxfoot-feature-bento__card--{{ block.settings.size }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    class: 'maxfoot-feature-bento__card-image',
                    alt: block.settings.title,
                    loading: 'lazy'
                }}
              {% else %}
                <div class="maxfoot-feature-bento__card-placeholder"></div>
              {% endif %}
              <div class="maxfoot-feature-bento__card-overlay"></div>
              <div class="maxfoot-feature-bento__card-content">
                <h3 class="maxfoot-feature-bento__card-title">{{ block.settings.title }}</h3>
                {% if block.settings.description != blank %}
                  <p class="maxfoot-feature-bento__card-desc">{{ block.settings.description }}</p>
                {% endif %}
                {% if block.settings.link_text != blank %}
                  <a href="{{ block.settings.link }}" class="maxfoot-feature-bento__card-link">
                    {{ block.settings.link_text }}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                {% endif %}
              </div>
            </div>
          {% when 'warranty_card' %}
            <div
              class="maxfoot-feature-bento__card maxfoot-feature-bento__card--small maxfoot-feature-bento__card--dark"
              {{ block.shopify_attributes }}
            >
              <div class="maxfoot-feature-bento__warranty-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                </svg>
              </div>
              <h3 class="maxfoot-feature-bento__warranty-title">{{ block.settings.title | default: '5-YEAR WARRANTY' }}</h3>
              <p class="maxfoot-feature-bento__warranty-desc">{{ block.settings.description | default: 'We stand by every weld. Engineered to outlast the competition.' }}</p>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .maxfoot-feature-bento {
    background-color: #FFFFFF;
    padding: 80px 48px;
  }

  .maxfoot-feature-bento__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .maxfoot-feature-bento__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    height: auto;
  }

  @media screen and (min-width: 768px) {
    .maxfoot-feature-bento__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, 320px);
      height: 640px;
    }
  }

  .maxfoot-feature-bento__card {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }

  .maxfoot-feature-bento__card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .maxfoot-feature-bento__card:hover .maxfoot-feature-bento__card-image {
    transform: scale(1.05);
  }

  .maxfoot-feature-bento__card-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  }

  .maxfoot-feature-bento__card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18, 18, 18, 0.8) 0%, transparent 50%);
    opacity: 0.9;
  }

  .maxfoot-feature-bento__card:hover .maxfoot-feature-bento__card-overlay {
    opacity: 0.95;
  }

  .maxfoot-feature-bento__card--large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .maxfoot-feature-bento__card--medium {
    grid-column: span 2;
    grid-row: span 1;
  }

  .maxfoot-feature-bento__card--small {
    grid-column: span 1;
    grid-row: span 1;
  }

  .maxfoot-feature-bento__card--dark {
    background-color: #121212;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px;
  }

  .maxfoot-feature-bento__card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 24px;
    z-index: 1;
  }

  @media screen and (min-width: 768px) {
    .maxfoot-feature-bento__card-content {
      padding: 32px;
    }
  }

  .maxfoot-feature-bento__card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.125rem, 2.5vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: #FFFFFF;
    margin: 0 0 8px 0;
  }

  .maxfoot-feature-bento__card--large .maxfoot-feature-bento__card-title {
    font-size: clamp(1.25rem, 3vw, 2rem);
  }

  .maxfoot-feature-bento__card-desc {
    font-family: 'Lexend', sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 16px 0;
    max-width: 280px;
  }

  .maxfoot-feature-bento__card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffc426;
    text-decoration: none;
    transition: gap 0.3s ease;
  }

  .maxfoot-feature-bento__card-link:hover {
    gap: 12px;
  }

  .maxfoot-feature-bento__card-link svg {
    transition: transform 0.3s ease;
  }

  .maxfoot-feature-bento__card-link:hover svg {
    transform: translateX(4px);
  }

  .maxfoot-feature-bento__warranty-icon {
    color: #ffc426;
    margin-bottom: 16px;
  }

  .maxfoot-feature-bento__warranty-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 8px 0;
  }

  .maxfoot-feature-bento__warranty-desc {
    font-family: 'Lexend', sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    .maxfoot-feature-bento {
      padding: 64px 24px;
    }

    .maxfoot-feature-bento__card--large,
    .maxfoot-feature-bento__card--medium {
      grid-column: span 1;
      grid-row: span 1;
      min-height: 280px;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Feature Bento",
  "tag": "section",
  "class": "maxfoot-feature-bento-section",
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Card Size",
          "options": [
            { "value": "large", "label": "Large (2x2)" },
            { "value": "medium", "label": "Medium (2x1)" },
            { "value": "small", "label": "Small (1x1)" }
          ],
          "default": "large"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "APEX SUSPENSION"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Hydraulic fork with 120mm of travel. Zero friction. Total control."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "TECH SPECS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "warranty_card",
      "name": "Warranty Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "5-YEAR WARRANTY"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We stand by every weld. Engineered to outlast the competition."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maxfoot Feature Bento",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "size": "large",
            "title": "APEX SUSPENSION",
            "description": "Hydraulic fork with 120mm of travel. Zero friction. Total control.",
            "link_text": "TECH SPECS"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "size": "medium",
            "title": "SMART HUB V2",
            "description": "Real-time GPS and health monitoring integration."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "size": "small",
            "title": "TERRAIN TIRES"
          }
        },
        {
          "type": "warranty_card",
          "settings": {
            "title": "5-YEAR WARRANTY",
            "description": "We stand by every weld. Engineered to outlast the competition."
          }
        }
      ]
    }
  ]
}
{% endschema %}
