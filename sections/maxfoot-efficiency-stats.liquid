{% comment %}
  Maxfoot Efficiency Stats Section - Technology Page
  Shows 28 MPH, 750W, 4.0 inch stats with progress bars and engineering image
{% endcomment %}

<section
  id="MaxfootEfficiencyStats-{{ section.id }}"
  class="maxfoot-efficiency-stats"
>
  <div class="maxfoot-efficiency-stats__container">
    <div class="maxfoot-efficiency-stats__content">
      <h2 class="maxfoot-efficiency-stats__title">
        MAXIMIZED <br/> <span class="text-accent">EFFICIENCY</span>
      </h2>

      <div class="maxfoot-efficiency-stats__grid">
        <div class="maxfoot-stat-item">
          <div class="maxfoot-stat-item__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-4h2v2h-2zm1-10c-1.66 0-3 1.34-3 3h2c0-.55.45-1 1-1s1 .45 1 1c0 1-2 1.5-2 4h2c0-1.5 2-2 2-4 0-1.66-1.34-3-3-3z"/>
            </svg>
          </div>
          <div class="maxfoot-stat-item__data">
            <div class="maxfoot-stat-item__value">28 <span>MPH</span></div>
            <div class="maxfoot-stat-item__label">Class-3 Unleashed Velocity</div>
            <div class="maxfoot-stat-item__progress">
              <div class="maxfoot-stat-item__progress-bar" style="width: 93%"></div>
            </div>
          </div>
        </div>

        <div class="maxfoot-stat-item">
          <div class="maxfoot-stat-item__icon maxfoot-stat-item__icon--yellow">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 2v11h3v9l7-12h-4l4-8z"/>
            </svg>
          </div>
          <div class="maxfoot-stat-item__data">
            <div class="maxfoot-stat-item__value">750 <span>WATTS</span></div>
            <div class="maxfoot-stat-item__label">Nominal Output Hub Motor</div>
            <div class="maxfoot-stat-item__progress">
              <div class="maxfoot-stat-item__progress-bar" style="width: 75%"></div>
            </div>
          </div>
        </div>

        <div class="maxfoot-stat-item">
          <div class="maxfoot-stat-item__icon maxfoot-stat-item__icon--white">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5.5-2.5l7.51-3.49L17.5 6.5 9.99 9.99 6.5 17.5zm5.5-6.6c.61 0 1.1.49 1.1 1.1s-.49 1.1-1.1 1.1-1.1-.49-1.1-1.1.49-1.1 1.1-1.1z"/>
            </svg>
          </div>
          <div class="maxfoot-stat-item__data">
            <div class="maxfoot-stat-item__value">4.0 <span>INCH</span></div>
            <div class="maxfoot-stat-item__label">Puncture Resistant Fat Tires</div>
            <div class="maxfoot-stat-item__progress">
              <div class="maxfoot-stat-item__progress-bar" style="width: 80%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="maxfoot-efficiency-stats__visual">
      <div class="maxfoot-efficiency-stats__image-wrapper">
        <div class="maxfoot-efficiency-stats__image-placeholder"></div>
        <div class="maxfoot-efficiency-stats__badge">Live Engineering Feed</div>
        <div class="maxfoot-efficiency-stats__radar">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
            <circle cx="12" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="2"/>
            <circle cx="12" cy="12" r="2" fill="currentColor"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .maxfoot-efficiency-stats {
    padding: 100px 48px;
    background-color: #FFFFFF;
  }

  .maxfoot-efficiency-stats__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  @media screen and (min-width: 768px) {
    .maxfoot-efficiency-stats__container {
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }
  }

  .maxfoot-efficiency-stats__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #121212;
    margin: 0 0 40px 0;
  }

  .maxfoot-efficiency-stats__title span {
    color: #ffc426;
  }

  .maxfoot-efficiency-stats__grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .maxfoot-stat-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .maxfoot-stat-item__icon {
    padding: 14px;
    background-color: rgba(255, 196, 38, 0.1);
    border: 1px solid rgba(255, 196, 38, 0.3);
    color: #ffc426;
    border-radius: 8px;
  }

  .maxfoot-stat-item__icon--yellow {
    background-color: rgba(255, 196, 38, 0.15);
    border-color: #ffc426;
    color: #ffc426;
  }

  .maxfoot-stat-item__icon--white {
    background-color: #F8F8F8;
    border-color: #e5e5e5;
    color: #121212;
  }

  .maxfoot-stat-item__data {
    flex: 1;
  }

  .maxfoot-stat-item__value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 32px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    color: #121212;
  }

  .maxfoot-stat-item__value span {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffc426;
  }

  .maxfoot-stat-item:nth-child(2) .maxfoot-stat-item__value span {
    color: #ffc426;
  }

  .maxfoot-stat-item:nth-child(3) .maxfoot-stat-item__value span {
    color: #6b6b6b;
  }

  .maxfoot-stat-item__label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin-top: 6px;
  }

  .maxfoot-stat-item__progress {
    width: 160px;
    height: 6px;
    background-color: #e5e5e5;
    margin-top: 8px;
    overflow: hidden;
    border-radius: 3px;
  }

  .maxfoot-stat-item__progress-bar {
    height: 100%;
    background: #ffc426;
    transition: width 1s ease;
    border-radius: 3px;
  }

  .maxfoot-efficiency-stats__visual {
    position: relative;
  }

  .maxfoot-efficiency-stats__image-wrapper {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
  }

  .maxfoot-efficiency-stats__image-placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
    border-radius: 8px;
  }

  .maxfoot-efficiency-stats__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background-color: #ffc426;
    color: #1a1c1c;
    padding: 4px 12px;
  }

  .maxfoot-efficiency-stats__radar {
    position: absolute;
    bottom: 16px;
    right: 16px;
    color: #00D4FF;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  @media screen and (max-width: 767px) {
    .maxfoot-efficiency-stats {
      padding: 64px 16px;
    }

    .maxfoot-efficiency-stats__title {
      font-size: 36px;
    }

    .maxfoot-stat-item__value {
      font-size: 28px;
    }

    .maxfoot-stat-item__progress {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Efficiency Stats",
  "tag": "section",
  "class": "maxfoot-efficiency-stats-section",
  "settings": [],
  "presets": [
    {
      "name": "Maxfoot Efficiency Stats"
    }
  ]
}
{% endschema %}
