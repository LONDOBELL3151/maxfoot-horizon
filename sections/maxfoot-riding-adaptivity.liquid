{% comment %}
  Maxfoot Riding Adaptivity Section - Technology Page
  Comparison rows showing efficiency optimization, torque response, and stability
{% endcomment %}

<section
  id="MaxfootRidingAdaptivity-{{ section.id }}"
  class="maxfoot-riding-adaptivity"
>
  <div class="maxfoot-riding-adaptivity__container">
    <div class="maxfoot-riding-adaptivity__header">
      <div class="maxfoot-riding-adaptivity__header-left">
        <h2 class="maxfoot-riding-adaptivity__title">
          RIDING <br/> <span class="text-accent">ADAPTIVITY</span>
        </h2>
        <p class="maxfoot-riding-adaptivity__subtitle">
          Real-time performance metrics optimized for diverse environmental conditions. Our firmware adjusts output 1000x per second.
        </p>
      </div>
      <div class="maxfoot-riding-adaptivity__header-right">
        <div class="maxfoot-riding-adaptivity__version-label">Current Tech Revision</div>
        <div class="maxfoot-riding-adaptivity__version">v2.0 HORIZON</div>
      </div>
    </div>

    <div class="maxfoot-riding-adaptivity__grid">
      {% for i in (1..3) %}
        {% case forloop.index %}
          {% when 1 %}
            {% assign icon = 'location_city' %}
            {% assign mode_label = 'Urban Flow' %}
            {% assign stat_label = 'Efficiency Optimization' %}
            {% assign stat_value = '94%' %}
            {% assign quote = 'Maximized range with regenerative braking for city traffic.' %}
          {% when 2 %}
            {% assign icon = 'terrain' %}
            {% assign mode_label = 'Apex Peak' %}
            {% assign stat_label = 'Torque Response' %}
            {% assign stat_value = '100%' %}
            {% assign quote = 'Unrestricted power delivery for 45° incline climbs.' %}
          {% when 3 %}
            {% assign icon = 'local_shipping' %}
            {% assign mode_label = 'Heavy Load' %}
            {% assign stat_label = 'Structural Stability' %}
            {% assign stat_value = '88%' %}
            {% assign quote = 'Electronic stability control adjusted for center of gravity.' %}
        {% endcase %}

        <div class="maxfoot-riding-card" data-index="{{ forloop.index }}">
          <div class="maxfoot-riding-card__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor">
              {% case icon %}
                {% when 'location_city' %}
                  <path d="M15 11V5l-3-3-3 3v2H3v14h18V11h-6zm-8 8H5v-2h2v2zm0-4H5v-2h2v2zm0-4H5V9h2v2zm6 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V9h2v2zm0-4h-2V5h2v2zm6 12h-2v-2h2v2zm0-4h-2v-2h2v2z"/>
                {% when 'terrain' %}
                  <path d="M14 6l-3.75 5 2.85 3.8-1.6 1.2C9.81 13.75 7 10 7 10l-6 8h22L14 6z"/>
                {% when 'local_shipping' %}
                  <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
              {% endcase %}
            </svg>
            <span class="maxfoot-riding-card__mode">{{ mode_label }}</span>
          </div>

          <div class="maxfoot-riding-card__stat">
            <div class="maxfoot-riding-card__stat-header">
              <span class="maxfoot-riding-card__stat-label">{{ stat_label }}</span>
              <span class="maxfoot-riding-card__stat-value">{{ stat_value }}</span>
            </div>
            <div class="maxfoot-riding-card__progress">
              <div class="maxfoot-riding-card__progress-bar" style="width: {{ stat_value }}"></div>
            </div>
          </div>

          <div class="maxfoot-riding-card__quote">
            {{ quote }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .maxfoot-riding-adaptivity {
    padding: 100px 48px;
    background-color: #FFFFFF;
  }

  .maxfoot-riding-adaptivity__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .maxfoot-riding-adaptivity__header {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-bottom: 48px;
  }

  @media screen and (min-width: 768px) {
    .maxfoot-riding-adaptivity__header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .maxfoot-riding-adaptivity__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #121212;
    margin: 0 0 12px 0;
  }

  .maxfoot-riding-adaptivity__title span {
    color: #ffc426;
  }

  .maxfoot-riding-adaptivity__subtitle {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #6b6b6b;
    max-width: 500px;
    margin: 0;
  }

  .maxfoot-riding-adaptivity__header-right {
    border-left: 2px solid #ffc426;
    padding-left: 24px;
  }

  .maxfoot-riding-adaptivity__version-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin-bottom: 4px;
  }

  .maxfoot-riding-adaptivity__version {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #121212;
  }

  .maxfoot-riding-adaptivity__grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .maxfoot-riding-card {
    display: grid;
    grid-template-columns: 100px 1fr 180px;
    align-items: center;
    gap: 24px;
    padding: 24px 28px;
    background-color: #F8F8F8;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .maxfoot-riding-card:hover {
    border-color: #ffc426;
  }

  .maxfoot-riding-card__icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .maxfoot-riding-card__icon svg {
    width: 32px;
    height: 32px;
  }

  .maxfoot-riding-card[data-index="1"] .maxfoot-riding-card__icon { color: #ffc426; }
  .maxfoot-riding-card[data-index="2"] .maxfoot-riding-card__icon { color: #ffc426; }
  .maxfoot-riding-card[data-index="3"] .maxfoot-riding-card__icon { color: #121212; }

  .maxfoot-riding-card__mode {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  .maxfoot-riding-card__stat {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .maxfoot-riding-card__stat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .maxfoot-riding-card__stat-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  .maxfoot-riding-card[data-index="1"] .maxfoot-riding-card__stat-value { color: #ffc426; }
  .maxfoot-riding-card[data-index="2"] .maxfoot-riding-card__stat-value { color: #ffc426; }
  .maxfoot-riding-card[data-index="3"] .maxfoot-riding-card__stat-value { color: #121212; }

  .maxfoot-riding-card__progress {
    height: 8px;
    background-color: #e5e5e5;
    overflow: hidden;
    border-radius: 4px;
  }

  .maxfoot-riding-card__progress-bar {
    height: 100%;
    background: #ffc426;
    transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 4px;
  }

  .maxfoot-riding-card[data-index="2"] .maxfoot-riding-card__progress-bar {
    width: 100%;
  }

  .maxfoot-riding-card__quote {
    font-family: 'Lexend', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: #6b6b6b;
  }

  @media screen and (max-width: 1023px) {
    .maxfoot-riding-card {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .maxfoot-riding-card__icon {
      flex-direction: row;
      justify-content: flex-start;
    }

    .maxfoot-riding-card__quote {
      border-top: 1px solid #e5e5e5;
      padding-top: 16px;
    }
  }

  @media screen and (max-width: 767px) {
    .maxfoot-riding-adaptivity {
      padding: 64px 24px;
    }

    .maxfoot-riding-adaptivity__title {
      font-size: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Riding Adaptivity",
  "tag": "section",
  "class": "maxfoot-riding-adaptivity-section",
  "settings": [],
  "presets": [
    {
      "name": "Maxfoot Riding Adaptivity"
    }
  ]
}
{% endschema %}
