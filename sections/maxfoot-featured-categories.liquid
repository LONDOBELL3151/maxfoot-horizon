{% comment %}
  Maxfoot Featured Categories Section - Homepage v4
  Each card pulls data from its referenced product
{% endcomment %}

<section
  id="MaxfootCategories-{{ section.id }}"
  class="maxfoot-categories"
>
  <div class="maxfoot-categories__container">
    <div class="maxfoot-categories__header">
      <div class="maxfoot-categories__header-content">
        <h2 class="maxfoot-categories__title">{{ section.settings.section_title | default: 'Engineered Series' }}</h2>
        <p class="maxfoot-categories__subtitle">{{ section.settings.section_subtitle | default: 'Specialized builds for diverse environmental challenges.' }}</p>
      </div>
      <div class="maxfoot-categories__section-number">{{ section.settings.section_number | default: '01' }}</div>
    </div>

    <div class="maxfoot-categories__grid">
      {% for block in section.blocks %}
        {% if block.type == 'product_card' %}
          {%- assign product = block.settings.product -%}
          {% if product %}
            <a
              href="{{ product.url }}"
              class="maxfoot-category-card"
              {{ block.shopify_attributes }}
            >
              <div class="maxfoot-category-card__image-wrapper">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      class: 'maxfoot-category-card__image',
                      alt: product.title,
                      widths: '400, 600, 800',
                      sizes: '(min-width: 768px) 33vw, 100vw',
                      loading: 'lazy'
                  }}
                {% else %}
                  <div class="maxfoot-category-card__placeholder"></div>
                {% endif %}
                <div class="maxfoot-category-card__overlay"></div>
              </div>
              <div class="maxfoot-category-card__content">
                {% if product.compare_at_price > product.price %}
                  <span class="maxfoot-category-card__badge">{{ 'products.product.on_sale' | t }}</span>
                {% elsif product.tags.first %}
                  <span class="maxfoot-category-card__badge">{{ product.tags.first }}</span>
                {% endif %}
                <h3 class="maxfoot-category-card__title">{{ product.title }}</h3>
                <div class="maxfoot-category-card__stats">
                  <div class="maxfoot-category-card__stat">
                    <p class="maxfoot-category-card__stat-label">{{ 'products.product.price.label' | t | default: 'Price' }}</p>
                    <p class="maxfoot-category-card__stat-value">
                      {% if product.compare_at_price > product.price %}
                        <span class="sale-price">{{ product.price | money }}</span>
                      {% else %}
                        {{ product.price | money }}
                      {% endif %}
                    </p>
                  </div>
                  {% if product.metafields.custom.peak_power %}
                    <div class="maxfoot-category-card__stat">
                      <p class="maxfoot-category-card__stat-label">Peak Power</p>
                      <p class="maxfoot-category-card__stat-value">{{ product.metafields.custom.peak_power }}</p>
                    </div>
                  {% elsif product.type %}
                    <div class="maxfoot-category-card__stat">
                      <p class="maxfoot-category-card__stat-label">Type</p>
                      <p class="maxfoot-category-card__stat-value">{{ product.type }}</p>
                    </div>
                  {% endif %}
                </div>
              </div>
            </a>
          {% endif %}
        {% endif %}
      {% else %}
        {% for i in (1..3) %}
          <a
            href="#"
            class="maxfoot-category-card"
          >
            <div class="maxfoot-category-card__image-wrapper">
              <div class="maxfoot-category-card__placeholder"></div>
              <div class="maxfoot-category-card__overlay"></div>
            </div>
            <div class="maxfoot-category-card__content">
              <span class="maxfoot-category-card__badge">Sample Badge</span>
              <h3 class="maxfoot-category-card__title">Product Title {{ i }}</h3>
              <div class="maxfoot-category-card__stats">
                <div class="maxfoot-category-card__stat">
                  <p class="maxfoot-category-card__stat-label">Price</p>
                  <p class="maxfoot-category-card__stat-value">${{ 1000 | times: i }}</p>
                </div>
                <div class="maxfoot-category-card__stat">
                  <p class="maxfoot-category-card__stat-label">Power</p>
                  <p class="maxfoot-category-card__stat-value">{{ 500 | times: i }}W</p>
                </div>
              </div>
            </div>
          </a>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .maxfoot-categories {
    padding: 100px 48px;
    background-color: #FFFFFF;
  }

  .maxfoot-categories__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .maxfoot-categories__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid #e5e5e5;
  }

  .maxfoot-categories__header-content {
    max-width: 500px;
  }

  .maxfoot-categories__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #121212;
    margin: 0 0 12px 0;
  }

  .maxfoot-categories__subtitle {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #6b6b6b;
    margin: 0;
  }

  .maxfoot-categories__section-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 48px;
    font-weight: 700;
    color: #ffc426;
    opacity: 0.8;
    line-height: 1;
  }

  .maxfoot-categories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media screen and (min-width: 768px) {
    .maxfoot-categories__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .maxfoot-category-card {
    position: relative;
    display: block;
    background: #ffffff;
    text-decoration: none;
    transition: all 0.4s ease;
    overflow: hidden;
  }

  .maxfoot-category-card:hover {
    transform: translateY(-8px);
  }

  .maxfoot-category-card__image-wrapper {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: #f5f5f5;
  }

  .maxfoot-category-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.7s ease;
  }

  .maxfoot-category-card:hover .maxfoot-category-card__image {
    transform: scale(1.05);
  }

  .maxfoot-category-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18, 18, 18, 0.7) 0%, transparent 60%);
    transition: opacity 0.3s ease;
  }

  .maxfoot-category-card:hover .maxfoot-category-card__overlay {
    opacity: 0.85;
  }

  .maxfoot-category-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px;
  }

  .maxfoot-category-card__badge {
    display: inline-block;
    background-color: #ffc426;
    color: #121212;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 12px;
    margin-bottom: 12px;
  }

  .maxfoot-category-card__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 16px 0;
  }

  .maxfoot-category-card__stats {
    display: flex;
    gap: 24px;
  }

  .maxfoot-category-card__stat {
    color: #ffffff;
  }

  .maxfoot-category-card__stat-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffc426;
    margin: 0 0 4px 0;
  }

  .maxfoot-category-card__stat-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 700;
    margin: 0;
  }

  .maxfoot-category-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5f5f5 0%, #e5e5e5 100%);
  }

  @media screen and (max-width: 767px) {
    .maxfoot-categories {
      padding: 64px 24px;
    }

    .maxfoot-categories__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 32px;
    }

    .maxfoot-categories__section-number {
      display: none;
    }

    .maxfoot-category-card__content {
      padding: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Categories",
  "tag": "section",
  "class": "maxfoot-categories-section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Engineered Series"
    },
    {
      "type": "textarea",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Specialized builds for diverse environmental challenges."
    },
    {
      "type": "text",
      "id": "section_number",
      "label": "Section Number",
      "default": "01"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "maxfoot-light"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Select a product to display"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maxfoot Categories",
      "blocks": [
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        }
      ]
    }
  ]
}
{% endschema %}
