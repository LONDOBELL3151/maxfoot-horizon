{% comment %}
  Maxfoot Featured Categories Section - Homepage v4
  Three category cards with diagonal-cut, hover effects, and stats
{% endcomment %}

<section
  id="MaxfootCategories-{{ section.id }}"
  class="maxfoot-categories"
>
  <div class="maxfoot-categories__container">
    <div class="maxfoot-categories__header">
      <div class="maxfoot-categories__header-content">
        <h2 class="maxfoot-categories__title">{{ section.settings.section_title | default: 'Engineered Series' }}</h2>
        <p class="maxfoot-categories__subtitle">{{ section.settings.section_subtitle | default: 'Specialized builds for diverse environmental challenges.' }}</p>
      </div>
      <div class="maxfoot-categories__section-number">{{ section.settings.section_number | default: '01' }}</div>
    </div>

    <div class="maxfoot-categories__grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'category_card' %}
            <a
              href="{{ block.settings.link }}"
              class="maxfoot-category-card"
              {{ block.shopify_attributes }}
            >
              <div class="maxfoot-category-card__image-wrapper">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'maxfoot-category-card__image',
                      alt: block.settings.title,
                      widths: '400, 600, 800',
                      sizes: '(min-width: 768px) 33vw, 100vw',
                      loading: 'lazy'
                  }}
                {% else %}
                  <div class="maxfoot-category-card__placeholder"></div>
                {% endif %}
                <div class="maxfoot-category-card__overlay"></div>
              </div>
              <div class="maxfoot-category-card__content">
                {% if block.settings.badge != blank %}
                  <span class="maxfoot-category-card__badge">{{ block.settings.badge }}</span>
                {% endif %}
                <h3 class="maxfoot-category-card__title">{{ block.settings.title }}</h3>
                <div class="maxfoot-category-card__stats">
                  {% if block.settings.stat_label_1 != blank %}
                    <div class="maxfoot-category-card__stat">
                      <p class="maxfoot-category-card__stat-label">{{ block.settings.stat_label_1 }}</p>
                      <p class="maxfoot-category-card__stat-value">{{ block.settings.stat_value_1 }}</p>
                    </div>
                  {% endif %}
                  {% if block.settings.stat_label_2 != blank %}
                    <div class="maxfoot-category-card__stat">
                      <p class="maxfoot-category-card__stat-label">{{ block.settings.stat_label_2 }}</p>
                      <p class="maxfoot-category-card__stat-value">{{ block.settings.stat_value_2 }}</p>
                    </div>
                  {% endif %}
                </div>
              </div>
            </a>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .maxfoot-categories {
    padding: 100px 48px;
    background-color: #FFFFFF;
  }

  .maxfoot-categories__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .maxfoot-categories__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid #e5e5e5;
  }

  .maxfoot-categories__header-content {
    max-width: 500px;
  }

  .maxfoot-categories__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #121212;
    margin: 0 0 12px 0;
  }

  .maxfoot-categories__subtitle {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #6b6b6b;
    margin: 0;
  }

  .maxfoot-categories__section-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 48px;
    font-weight: 700;
    color: #ffc426;
    opacity: 0.8;
    line-height: 1;
  }

  .maxfoot-categories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media screen and (min-width: 768px) {
    .maxfoot-categories__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .maxfoot-category-card {
    position: relative;
    display: block;
    background: #ffffff;
    text-decoration: none;
    transition: all 0.4s ease;
    overflow: hidden;
  }

  .maxfoot-category-card:hover {
    transform: translateY(-8px);
  }

  .maxfoot-category-card__image-wrapper {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: #f5f5f5;
  }

  .maxfoot-category-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.7s ease;
  }

  .maxfoot-category-card:hover .maxfoot-category-card__image {
    transform: scale(1.05);
  }

  .maxfoot-category-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18, 18, 18, 0.7) 0%, transparent 60%);
    transition: opacity 0.3s ease;
  }

  .maxfoot-category-card:hover .maxfoot-category-card__overlay {
    opacity: 0.85;
  }

  .maxfoot-category-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px;
  }

  .maxfoot-category-card__badge {
    display: inline-block;
    background-color: #ffc426;
    color: #121212;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 12px;
    margin-bottom: 12px;
  }

  .maxfoot-category-card__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 16px 0;
  }

  .maxfoot-category-card__stats {
    display: flex;
    gap: 24px;
  }

  .maxfoot-category-card__stat {
    color: #ffffff;
  }

  .maxfoot-category-card__stat-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffc426;
    margin: 0 0 4px 0;
  }

  .maxfoot-category-card__stat-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 700;
    margin: 0;
  }

  .maxfoot-category-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5f5f5 0%, #e5e5e5 100%);
  }

  @media screen and (max-width: 767px) {
    .maxfoot-categories {
      padding: 64px 24px;
    }

    .maxfoot-categories__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 32px;
    }

    .maxfoot-categories__section-number {
      display: none;
    }

    .maxfoot-category-card__content {
      padding: 24px;
    }
  }
</style>

