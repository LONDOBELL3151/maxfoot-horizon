{% schema %}
{
  "name": "V5 Homepage",
  "tag": "section",
  "class": "maxfoot-v5-homepage",
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "MAXFOOT"
    },
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Hero Badge",
      "default": "NEW GENERATION E-BIKE"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Unleash the RAW Power"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Meet the M-3, a high-torque beast engineered for those who demand uncompromising performance on every terrain."
    },
    {
      "type": "text",
      "id": "hero_cta_primary",
      "label": "Primary CTA",
      "default": "PRE-ORDER NOW"
    },
    {
      "type": "text",
      "id": "hero_cta_secondary",
      "label": "Secondary CTA",
      "default": "TECHNICAL SPECS"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "header",
      "content": "Hot Selling Section"
    },
    {
      "type": "text",
      "id": "hot_selling_title",
      "label": "Hot Selling Title",
      "default": "HOT SELLING"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "header",
      "content": "Technical Specs"
    },
    {
      "type": "text",
      "id": "spec_1_value",
      "label": "Spec 1 Value",
      "default": "750W"
    },
    {
      "type": "text",
      "id": "spec_1_label",
      "label": "Spec 1 Label",
      "default": "Brushless Motor"
    },
    {
      "type": "text",
      "id": "spec_2_value",
      "label": "Spec 2 Value",
      "default": "60 MILES"
    },
    {
      "type": "text",
      "id": "spec_2_label",
      "label": "Spec 2 Label",
      "default": "Estimated Range"
    },
    {
      "type": "text",
      "id": "spec_3_value",
      "label": "Spec 3 Value",
      "default": "28 MPH"
    },
    {
      "type": "text",
      "id": "spec_3_label",
      "label": "Spec 3 Label",
      "default": "Top Speed"
    },
    {
      "type": "text",
      "id": "spec_4_value",
      "label": "Spec 4 Value",
      "default": "FAT TIRE"
    },
    {
      "type": "text",
      "id": "spec_4_label",
      "label": "Spec 4 Label",
      "default": "All-Terrain Ready"
    },
    {
      "type": "header",
      "content": "Reviews Section"
    },
    {
      "type": "text",
      "id": "reviews_title",
      "label": "Reviews Title",
      "default": "Rider Experiences"
    },
    {
      "type": "text",
      "id": "reviews_subtitle",
      "label": "Reviews Subtitle",
      "default": "4.9/5 based on 1,200+ reviews"
    },
    {
      "type": "header",
      "content": "Stories Section"
    },
    {
      "type": "text",
      "id": "stories_title",
      "label": "Stories Title",
      "default": "Latest Stories"
    },
    {
      "type": "text",
      "id": "stories_link_text",
      "label": "Stories Link Text",
      "default": "All Stories"
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "text",
      "id": "footer_tagline",
      "label": "Footer Tagline",
      "default": "Pioneering the future of electric mobility with high-performance bikes designed for the modern adventurer."
    },
    {
      "type": "text",
      "id": "footer_copyright",
      "label": "Copyright",
      "default": "© 2024 MAXFOOT ELECTRIC BIKES. ENGINEERED FOR ADVENTURE."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Is Active",
          "default": false
        }
      ]
    },
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text",
          "default": "HOT"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        }
      ]
    },
    {
      "type": "review_card",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "default": 5
        }
      ]
    },
    {
      "type": "blog_card",
      "name": "Blog Card",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category"
        }
      ]
    },
    {
      "type": "footer_link",
      "name": "Footer Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5 Homepage"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

<!-- TopNavBar -->
<header class="bg-white/90 backdrop-blur-md border-b border-stone-100 sticky top-0 z-50">
  <div class="flex justify-between items-center w-full px-8 py-4 max-w-[1440px] mx-auto">
    <div class="text-2xl font-bold tracking-tighter text-stone-900">{{ section.settings.brand_name }}</div>
    <nav class="hidden md:flex items-center space-x-8">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_link' -%}
          <a
            class="text-stone-500 font-medium hover:text-[#FFC426] transition-colors duration-200 text-sm tracking-widest {% if block.settings.is_active %}text-[#FFC426] font-bold{% endif %}"
            href="{{ block.settings.link_url }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.link_text }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
    <div class="flex items-center space-x-6">
      <span class="material-symbols-outlined text-stone-500 cursor-pointer hover:text-[#FFC426] transition-colors">shopping_cart</span>
      <span class="material-symbols-outlined text-stone-500 cursor-pointer hover:text-[#FFC426] transition-colors">person</span>
      <button class="bg-[#FFC426] text-stone-900 px-6 py-2 font-bold text-sm tracking-widest active:scale-95 transition-transform duration-150 rounded-lg">TEST RIDE</button>
    </div>
  </div>
</header>

<main>
  <!-- Hero Section -->
  <section class="relative bg-white overflow-hidden min-h-[870px] flex items-center">
    <div class="max-w-[1440px] mx-auto px-8 w-full grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-6 z-10 py-12">
        <div class="inline-block bg-[#FFC426] text-stone-900 px-4 py-1 mb-6 rounded-sm">
          <span class="font-bold text-sm tracking-widest uppercase">{{ section.settings.hero_badge }}</span>
        </div>
        <h1 class="text-5xl md:text-7xl font-bold text-stone-900 mb-6 leading-tight">
          {{ section.settings.hero_title }}
        </h1>
        <p class="text-lg text-stone-500 mb-10 max-w-lg">
          {{ section.settings.hero_description }}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <button class="bg-[#FFC426] text-stone-900 px-10 py-4 font-bold text-sm tracking-widest uppercase rounded hover:opacity-90 transition-opacity">
            {{ section.settings.hero_cta_primary }}
          </button>
          <button class="border-2 border-stone-900 text-stone-900 px-10 py-4 font-bold text-sm tracking-widest uppercase rounded hover:bg-stone-900 hover:text-white transition-all">
            {{ section.settings.hero_cta_secondary }}
          </button>
        </div>
      </div>
      <div class="md:col-span-6 relative h-full flex justify-center items-center">
        <div class="relative w-full aspect-square md:aspect-auto md:h-[700px]">
          {%- if section.settings.hero_image -%}
            <img alt="Hero Image" class="w-full h-full object-contain transform scale-110" src="{{ section.settings.hero_image | image_url }}">
          {%- else -%}
            <img alt="Maxfoot M-3 High-Performance E-Bike" class="w-full h-full object-contain transform scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB2IH7UTWZNPde0A1_mJFDXAuTYjRcsJyMiw2nSPpt-OmP3n9qDEC5PT7SiWVPlEZCsiObSsxNTDkrIzmvmvHcciq9KQdL1BzN0q6yKteJt9CQJmdIEknam0a4A4KGEnxGV4_GyxXurxf9j3MqlqENjhdd_aMTtANyK8luYkd_APx5OJwu5al8tHJZ0nQkTiAWauJkLOFJODjgsN1ScbMhsZvz91eTjkvzk6QfDaoan5qqruf_Wp6tHYuUvx4qFHRtE1USeHqkFuTOl" alt="">
          {%- endif -%}
          <div class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-gradient-to-r from-stone-100 to-transparent opacity-50 rounded-full"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Hot Selling Section -->
  <section class="py-[120px] bg-white">
    <div class="max-w-[1440px] mx-auto px-8">
      <div class="flex justify-between items-end mb-12">
        <h2 class="text-4xl font-bold text-stone-900 uppercase tracking-tight">{{ section.settings.hot_selling_title }}</h2>
        <a class="text-[#FFC426] font-bold text-sm tracking-widest border-b-2 border-[#FFC426] pb-1 hover:opacity-80 transition-opacity" href="#">{{ section.settings.view_all_text }}</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {%- for block in section.blocks -%}
          {%- if block.type == 'product_card' -%}
            {%- assign product = block.settings.product -%}
            <div class="group bg-stone-50 border border-stone-100 rounded-xl overflow-hidden hover:shadow-xl transition-all duration-300" {{ block.shopify_attributes }}>
              <div class="relative aspect-square bg-stone-50 overflow-hidden">
                <div class="absolute top-4 left-4 z-10 bg-[#FFC426] text-stone-900 px-3 py-1 font-bold text-xs tracking-widest uppercase rounded-sm">
                  {{ block.settings.badge }}
                </div>
                {%- if block.settings.image -%}
                  <img alt="{{ product.title }}" class="w-full h-full object-contain p-8 group-hover:scale-110 transition-transform duration-500" src="{{ block.settings.image | image_url }}">
                {%- elsif product -%}
                  <img alt="{{ product.title }}" class="w-full h-full object-contain p-8 group-hover:scale-110 transition-transform duration-500" src="{{ product.featured_image | image_url: width: 400 }}">
                {%- else -%}
                  <div class="w-full h-full flex items-center justify-center">Product Image</div>
                {%- endif -%}
              </div>
              <div class="p-6 text-center">
                <h3 class="text-xl font-bold mb-2">{{ block.settings.product.title | default: 'Product Title' }}</h3>
                <p class="text-xl font-bold text-[#FFC426]">${{ 1299 | default: 0 }}.00</p>
              </div>
            </div>
          {%- endif -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="group bg-stone-50 border border-stone-100 rounded-xl overflow-hidden hover:shadow-xl transition-all duration-300">
              <div class="relative aspect-square bg-stone-50 overflow-hidden">
                <div class="absolute top-4 left-4 z-10 bg-[#FFC426] text-stone-900 px-3 py-1 font-bold text-xs tracking-widest uppercase rounded-sm">
                  HOT
                </div>
                <div class="w-full h-full flex items-center justify-center text-stone-400">Product {{ i }}</div>
              </div>
              <div class="p-6 text-center">
                <h3 class="text-xl font-bold mb-2">MAXFOOT M-{{ i }}</h3>
                <p class="text-xl font-bold text-[#FFC426]">${{ 1299 | times: i }}.00</p>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- Technical Specs -->
  <section class="py-[120px] bg-stone-50">
    <div class="max-w-[1440px] mx-auto px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="p-8 bg-white border border-stone-100 rounded-xl hover:border-[#FFC426] transition-colors group">
          <span class="material-symbols-outlined text-[#FFC426] text-4xl mb-4">bolt</span>
          <h3 class="text-2xl font-bold mb-2">{{ section.settings.spec_1_value }}</h3>
          <p class="text-sm text-stone-400 uppercase tracking-widest">{{ section.settings.spec_1_label }}</p>
        </div>
        <div class="p-8 bg-white border border-stone-100 rounded-xl hover:border-[#FFC426] transition-colors group">
          <span class="material-symbols-outlined text-[#FFC426] text-4xl mb-4">battery_charging_full</span>
          <h3 class="text-2xl font-bold mb-2">{{ section.settings.spec_2_value }}</h3>
          <p class="text-sm text-stone-400 uppercase tracking-widest">{{ section.settings.spec_2_label }}</p>
        </div>
        <div class="p-8 bg-white border border-stone-100 rounded-xl hover:border-[#FFC426] transition-colors group">
          <span class="material-symbols-outlined text-[#FFC426] text-4xl mb-4">speed</span>
          <h3 class="text-2xl font-bold mb-2">{{ section.settings.spec_3_value }}</h3>
          <p class="text-sm text-stone-400 uppercase tracking-widest">{{ section.settings.spec_3_label }}</p>
        </div>
        <div class="p-8 bg-white border border-stone-100 rounded-xl hover:border-[#FFC426] transition-colors group">
          <span class="material-symbols-outlined text-[#FFC426] text-4xl mb-4">terrain</span>
          <h3 class="text-2xl font-bold mb-2">{{ section.settings.spec_4_value }}</h3>
          <p class="text-sm text-stone-400 uppercase tracking-widest">{{ section.settings.spec_4_label }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews Section -->
  <section class="py-[120px] bg-stone-100">
    <div class="max-w-[1440px] mx-auto px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-stone-900 mb-4">{{ section.settings.reviews_title }}</h2>
        <p class="text-[#FFC426] font-bold tracking-widest uppercase">{{ section.settings.reviews_subtitle }}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review_card' -%}
            <div class="bg-white p-8 rounded-xl shadow-sm border border-stone-100 flex flex-col items-center text-center" {{ block.shopify_attributes }}>
              <div class="w-16 h-16 rounded-full bg-stone-200 mb-6 flex items-center justify-center">
                <span class="material-symbols-outlined text-stone-400 text-3xl">person</span>
              </div>
              <h4 class="text-lg font-bold mb-2">{{ block.settings.reviewer_name }}</h4>
              <div class="flex text-[#FFC426] mb-4">
                {%- for i in (1..5) -%}
                  <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' {% if i <= block.settings.rating %}1{% else %}0{% endif %};">star</span>
                {%- endfor -%}
              </div>
              <p class="text-stone-500 italic">"{{ block.settings.review_text }}"</p>
            </div>
          {%- endif -%}
        {%- else -%}
          {%- assign reviews = '{"name":"James Miller","text":"The M-3 is an absolute beast. The torque is incredible for off-road trails."}|{"name":"Sarah Chen","text":"Replaced my car for city commuting. Best decision I have made."}|{"name":"Marcus Wright","text":"Build quality is top-notch. It feels sturdy and very premium."}|{"name":"Elena Rossi","text":"Customer support helped me with all my technical questions."}' | split: '|' -%}
          {%- for review in reviews -%}
            {%- assign review_data = review | split: '":"' -%}
            <div class="bg-white p-8 rounded-xl shadow-sm border border-stone-100 flex flex-col items-center text-center">
              <div class="w-16 h-16 rounded-full bg-stone-200 mb-6 flex items-center justify-center">
                <span class="material-symbols-outlined text-stone-400 text-3xl">person</span>
              </div>
              <h4 class="text-lg font-bold mb-2">{{ review_data[0] }}</h4>
              <div class="flex text-[#FFC426] mb-4">
                <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">star</span>
              </div>
              <p class="text-stone-500 italic">"{{ review_data[1] }}"</p>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</main>

<!-- Footer -->
<footer class="bg-stone-900 border-t border-stone-800">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-12 px-8 py-24 max-w-[1440px] mx-auto">
    <div class="flex flex-col space-y-6">
      <div class="text-xl font-black tracking-widest text-white uppercase">{{ section.settings.brand_name }}</div>
      <p class="text-stone-400 leading-relaxed">{{ section.settings.footer_tagline }}</p>
      <div class="flex space-x-4">
        <span class="material-symbols-outlined text-[#FFC426] cursor-pointer">public</span>
        <span class="material-symbols-outlined text-[#FFC426] cursor-pointer">chat</span>
        <span class="material-symbols-outlined text-[#FFC426] cursor-pointer">mail</span>
      </div>
    </div>
    <div class="flex flex-col space-y-4">
      <h4 class="text-white font-bold text-sm tracking-widest uppercase mb-4">SUPPORT</h4>
      {%- for block in section.blocks -%}
        {%- if block.type == 'footer_link' -%}
          <a class="text-stone-400 hover:text-white transition-colors text-sm" href="{{ block.settings.link_url }}" {{ block.shopify_attributes }}>{{ block.settings.link_text }}</a>
        {%- endif -%}
      {%- else -%}
        <a class="text-stone-400 hover:text-white transition-colors text-sm" href="#">WARRANTY</a>
        <a class="text-stone-400 hover:text-white transition-colors text-sm" href="#">RETURNS</a>
        <a class="text-stone-400 hover:text-white transition-colors text-sm" href="#">CONTACT</a>
      {%- endfor -%}
    </div>
    <div class="flex flex-col space-y-4">
      <h4 class="text-white font-bold text-sm tracking-widest uppercase mb-4">LEGAL</h4>
      <a class="text-stone-400 hover:text-white transition-colors text-sm" href="#">PRIVACY POLICY</a>
      <a class="text-stone-400 hover:text-white transition-colors text-sm" href="#">TERMS OF SERVICE</a>
    </div>
    <div class="flex flex-col space-y-6">
      <h4 class="text-white font-bold text-sm tracking-widest uppercase mb-4">NEWSLETTER</h4>
      <div class="flex border-b border-stone-700 pb-2">
        <input class="bg-transparent border-none text-white text-sm focus:ring-0 w-full placeholder-stone-600" placeholder="YOUR EMAIL" type="email">
        <button class="text-[#FFC426] material-symbols-outlined">arrow_forward</button>
      </div>
    </div>
  </div>
  <div class="max-w-[1440px] mx-auto px-8 py-8 border-t border-stone-800">
    <p class="text-stone-500 text-sm text-center md:text-left">{{ section.settings.footer_copyright }}</p>
  </div>
</footer>
