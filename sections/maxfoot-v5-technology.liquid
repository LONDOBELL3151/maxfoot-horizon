{% schema %}
{
  "name": "V5 Technology",
  "tag": "section",
  "class": "maxfoot-v5-technology",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "E-ADVENTURE"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "ENGINEERED TO DOMINATE"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Pushing the boundaries of electric mobility with aerospace-grade materials and industry-leading torque management."
    },
    {
      "type": "text",
      "id": "hero_stat_value",
      "label": "Hero Stat Value",
      "default": "95"
    },
    {
      "type": "text",
      "id": "hero_stat_unit",
      "label": "Hero Stat Unit",
      "default": "Nm"
    },
    {
      "type": "text",
      "id": "hero_stat_label",
      "label": "Hero Stat Label",
      "default": "Instant Peak Torque"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 Value",
      "default": "28"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "MPH TOP SPEED"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 Value",
      "default": "750"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "W NOMINAL"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3 Value",
      "default": "4.0"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "INCH TREAD"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Nav Link",
      "settings": [
        { "type": "text", "id": "link_text", "label": "Link Text" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    },
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (material symbol)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "V5 Technology" }]
}
{% endschema %}

<!-- TopNavBar -->
<nav class="bg-white/95 backdrop-blur-md border-b border-zinc-100 docked full-width top-0 sticky z-50 transition-all duration-200 ease-in-out">
<div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
<div class="text-2xl font-bold tracking-tighter text-zinc-900">{{ section.settings.brand_name }}</div>
<div class="hidden md:flex items-center gap-8">
  {%- for block in section.blocks -%}{%- if block.type == 'nav_link' -%}<a class="text-zinc-600 hover:text-zinc-900 transition-colors font-label-lg uppercase" href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a>{%- endif -%}{%- endfor -%}
</div>
<div class="flex items-center gap-6">
<div class="hidden lg:flex items-center bg-surface-container px-4 py-2 rounded-lg">
<span class="material-symbols-outlined text-zinc-400 mr-2">search</span>
<input class="bg-transparent border-none focus:ring-0 text-sm w-32 font-body-md" placeholder="Search technology..." type="text"/>
</div>
<button class="bg-primary-container text-on-primary-container px-6 py-2.5 rounded-lg font-label-lg transition-all hover:opacity-90">Shop Now</button>
</div>
</div>
</nav>

<!-- Hero Section -->
<header class="relative min-h-[921px] flex flex-col justify-center overflow-hidden hero-gradient">
<div class="max-w-7xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center py-[120px]">
<div class="z-10">
<div class="inline-flex items-center bg-primary-container text-on-primary-container px-4 py-1.5 rounded-full mb-8">
<span class="font-label-lg uppercase tracking-widest text-[11px]">Next Generation Performance</span>
</div>
<h1 class="font-display-lg text-on-surface uppercase mb-6 leading-[0.95]">{{ section.settings.hero_title }}</h1>
<p class="font-body-lg text-on-surface-variant max-w-md mb-10">{{ section.settings.hero_description }}</p>
<div class="flex flex-wrap gap-4">
<button class="bg-primary-container text-on-primary-container px-10 py-4 rounded-lg font-label-lg uppercase transition-all hover:scale-105">Experience Power</button>
<button class="border-2 border-zinc-900 text-zinc-900 px-10 py-4 rounded-lg font-label-lg uppercase transition-all hover:bg-zinc-900 hover:text-white">White Papers</button>
</div>
</div>
<div class="relative flex justify-center">
<div class="absolute -z-10 w-[140%] h-[140%] bg-primary-container/10 blur-[100px] rounded-full"></div>
<div class="bg-white p-8 rounded-xl shadow-2xl border border-zinc-100 flex flex-col items-center">
<div class="text-[120px] font-display-lg text-primary leading-none mb-2">{{ section.settings.hero_stat_value }}<span class="text-4xl font-headline-lg ml-2">{{ section.settings.hero_stat_unit }}</span></div>
<div class="font-label-lg uppercase tracking-widest text-on-surface-variant">{{ section.settings.hero_stat_label }}</div>
<div class="w-full h-px bg-zinc-100 my-8"></div>
<div class="grid grid-cols-2 gap-8 w-full">
<div>
<div class="font-headline-lg text-on-surface">4.2s</div>
<div class="text-[10px] font-label-md uppercase text-zinc-400">0-20 MPH</div>
</div>
<div>
<div class="font-headline-lg text-on-surface">98%</div>
<div class="text-[10px] font-label-md uppercase text-zinc-400">Efficiency</div>
</div>
</div>
</div>
</div>
</div>
</header>

<!-- Core Innovations (Bento Grid) -->
<section class="bg-white py-[120px]">
<div class="max-w-7xl mx-auto px-6">
<div class="flex flex-col items-center text-center mb-16">
<h2 class="font-headline-xl uppercase mb-4">Core Innovations</h2>
<div class="w-20 h-1.5 bg-primary-container"></div>
</div>
<div class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-[280px]">
<!-- Feature 1: Large Bento -->
<div class="md:col-span-8 md:row-span-2 bento-card bg-surface-container-low rounded-xl overflow-hidden group">
<div class="h-full w-full relative">
<img class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" alt="Power Cell v4 battery" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAujOYG_7TZl-jA8tC6wfKEQaO6xczpZTFKV9aBEUUqcoVHzM7qKrDPZPxco_YARvlSi1m3mf7xvfxq1bgeYJfPr9yBkxK1pj0-0Cl1p5KwxX9wFgKAXF7bUQIefzXHKqiMLDyobBcyfzvgkN23Zah63xI1PlWhc5MXUsebwSTxUZAb2MV04PFqz-uDlXplCz-_5GNejx0dYu2JJIxjIfmeb9kmU0qlrTcbbUZOtSMqyJry3Ch43M2pmdyrzu5NxARZTth8LCphbtdS"/>
<div class="absolute inset-0 bg-gradient-to-t from-zinc-900/80 to-transparent"></div>
<div class="absolute bottom-0 left-0 p-10 text-white">
<span class="bg-primary-container text-on-primary-container px-3 py-1 rounded font-label-md uppercase mb-4 inline-block">Flagship Tech</span>
<h3 class="font-headline-xl uppercase mb-4">Power Cell v4</h3>
<p class="font-body-md text-zinc-300 max-w-md">Our patented thermal shielding technology maintains optimal operating temperatures even under extreme heavy-load conditions.</p>
</div>
</div>
</div>
{%- for block in section.blocks -%}{%- if block.type == 'feature_card' -%}
<div class="md:col-span-4 bento-card bg-white border border-zinc-100 p-8 flex flex-col justify-between rounded-xl">
<span class="material-symbols-outlined text-primary text-4xl">{{ block.settings.icon }}</span>
<div>
<h4 class="font-headline-lg uppercase mb-2">{{ block.settings.title }}</h4>
<p class="text-on-surface-variant font-body-md">{{ block.settings.description }}</p>
</div>
</div>
{%- endif -%}{%- endfor -%}
<!-- Wide Bento: Ultra-Connect Hub -->
<div class="md:col-span-12 md:row-span-1 bento-card bg-surface-container rounded-xl overflow-hidden flex flex-col md:flex-row items-center">
<div class="p-10 flex-1">
<h4 class="font-headline-xl uppercase mb-4">Ultra-Connect Hub</h4>
<p class="text-on-surface-variant font-body-md mb-6">Seamless integration with your ecosystem. Real-time diagnostics, over-the-air updates, and military-grade GPS tracking.</p>
<div class="flex gap-4">
<span class="font-label-lg text-primary uppercase">Bluetooth 5.3</span>
<span class="font-label-lg text-primary uppercase">5G Lte</span>
<span class="font-label-lg text-primary uppercase">RFID Lock</span>
</div>
</div>
<div class="flex-1 h-full w-full bg-zinc-200">
<img class="w-full h-full object-cover" alt="Smartphone diagnostic app" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA1QG1vJZmszWb3D-g7Aa5-xVCuFLGGDOSDg76rNrvtqC0KrjAkT5RrGCCENIoKQSaS9DOQ8UShB3f2N6Jqj3tm_j1sVE4AuYpsr9ugLOJiXUyPGRGQEs6hKjsE5vQkPJOOO35LAo5KfERsj7nbLLjq7e5LJX6tMWBm7XqaqLE9woNGUZvBz3DxDj7w3poq4RF8h_nubr4XkwdRXJtMCvf3OJwgqflhK6RTlfyfllzgB1yJF7ySV8aM_AsvC1MMMwkwX1g3PGeilPap"/>
</div>
</div>
</div>
</div>
</section>

