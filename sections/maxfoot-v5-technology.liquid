{% schema %}
{
  "name": "V5 Technology",
  "tag": "section",
  "class": "maxfoot-v5-technology",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "MAXFOOT"
    },
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Hero Badge",
      "default": "Next Generation Performance"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "ENGINEERED TO DOMINATE"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Pushing the boundaries of electric mobility with aerospace-grade materials and industry-leading torque management."
    },
    {
      "type": "text",
      "id": "hero_stat_value",
      "label": "Hero Stat Value",
      "default": "95"
    },
    {
      "type": "text",
      "id": "hero_stat_unit",
      "label": "Hero Stat Unit",
      "default": "Nm"
    },
    {
      "type": "text",
      "id": "hero_stat_label",
      "label": "Hero Stat Label",
      "default": "Instant Peak Torque"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Nav Link",
      "settings": [
        { "type": "text", "id": "link_text", "label": "Link Text" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    },
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (material symbol)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "V5 Technology" }]
}
{% endschema %}

<nav class="bg-white/95 backdrop-blur-md border-b border-stone-100 sticky top-0 z-50">
  <div class="max-w-[1440px] mx-auto px-8 h-20 flex items-center justify-between">
    <div class="text-2xl font-bold tracking-tighter text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">{{ section.settings.brand_name }}</div>
    <div class="hidden md:flex items-center gap-8">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_link' -%}
          <a class="text-stone-600 hover:text-[#FFC426] transition-colors font-bold uppercase text-sm tracking-widest" style="font-family: 'Space Grotesk', sans-serif;" href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a>
        {%- endif -%}
      {%- else -%}
        <a class="text-stone-600 hover:text-[#FFC426] transition-colors font-bold uppercase text-sm tracking-widest" style="font-family: 'Space Grotesk', sans-serif;" href="#">Bikes</a>
        <a class="text-[#FFC426] border-b-2 border-[#FFC426] pb-1 font-bold uppercase text-sm tracking-widest" style="font-family: 'Space Grotesk', sans-serif;" href="#">Technology</a>
        <a class="text-stone-600 hover:text-[#FFC426] transition-colors font-bold uppercase text-sm tracking-widest" style="font-family: 'Space Grotesk', sans-serif;" href="#">Innovation</a>
        <a class="text-stone-600 hover:text-[#FFC426] transition-colors font-bold uppercase text-sm tracking-widest" style="font-family: 'Space Grotesk', sans-serif;" href="#">Support</a>
      {%- endfor -%}
    </div>
    <div class="flex items-center gap-6">
      <button class="bg-[#FFC426] text-stone-900 px-6 py-2.5 rounded-lg font-bold uppercase text-sm tracking-widest transition-all hover:opacity-90" style="font-family: 'Space Grotesk', sans-serif;">Shop Now</button>
    </div>
  </div>
</nav>

<header class="relative min-h-[921px] flex flex-col justify-center overflow-hidden bg-gradient-to-b from-white to-stone-50">
  <div class="max-w-[1440px] mx-auto px-8 w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center py-[120px]">
    <div class="z-10">
      <div class="inline-flex items-center bg-[#FFC426] text-stone-900 px-4 py-1.5 rounded-full mb-8">
        <span class="font-bold uppercase tracking-widest text-xs" style="font-family: 'Space Grotesk', sans-serif;">{{ section.settings.hero_badge }}</span>
      </div>
      <h1 class="text-5xl lg:text-7xl font-bold text-stone-900 uppercase mb-6 leading-[0.95]" style="font-family: 'Space Grotesk', sans-serif;">{{ section.settings.hero_title }}</h1>
      <p class="text-lg text-stone-600 max-w-md mb-10 leading-relaxed" style="font-family: 'Lexend', sans-serif;">{{ section.settings.hero_description }}</p>
      <div class="flex flex-wrap gap-4">
        <button class="bg-[#FFC426] text-stone-900 px-10 py-4 rounded-lg font-bold uppercase text-sm tracking-widest transition-all hover:opacity-90" style="font-family: 'Space Grotesk', sans-serif;">Experience Power</button>
        <button class="border-2 border-stone-900 text-stone-900 px-10 py-4 rounded-lg font-bold uppercase text-sm tracking-widest transition-all hover:bg-stone-900 hover:text-white" style="font-family: 'Space Grotesk', sans-serif;">White Papers</button>
      </div>
    </div>
    <div class="relative flex justify-center">
      <div class="absolute -z-10 w-[140%] h-[140%] bg-[#FFC426]/10 blur-[100px] rounded-full"></div>
      <div class="bg-white p-8 rounded-xl shadow-2xl border border-stone-100 flex flex-col items-center">
        <div class="text-[120px] font-bold text-[#FFC426] leading-none mb-2" style="font-family: 'Space Grotesk', sans-serif;">{{ section.settings.hero_stat_value }}<span class="text-4xl font-bold ml-2">{{ section.settings.hero_stat_unit }}</span></div>
        <div class="font-bold uppercase tracking-widest text-stone-500 text-sm" style="font-family: 'Space Grotesk', sans-serif;">{{ section.settings.hero_stat_label }}</div>
        <div class="w-full h-px bg-stone-100 my-8"></div>
        <div class="grid grid-cols-2 gap-8 w-full">
          <div>
            <div class="text-2xl font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">4.2s</div>
            <div class="text-[10px] uppercase tracking-widest text-stone-400">0-20 MPH</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">98%</div>
            <div class="text-[10px] uppercase tracking-widest text-stone-400">Efficiency</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<section class="bg-white py-[120px]">
  <div class="max-w-[1440px] mx-auto px-8">
    <div class="flex flex-col items-center text-center mb-16">
      <h2 class="text-4xl lg:text-5xl font-bold text-stone-900 uppercase mb-4" style="font-family: 'Space Grotesk', sans-serif;">Core Innovations</h2>
      <div class="w-20 h-1.5 bg-[#FFC426]"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-[280px]">
      <div class="md:col-span-8 md:row-span-2 bg-stone-900 rounded-xl overflow-hidden group relative">
        <img class="absolute inset-0 w-full h-full object-cover opacity-60 transition-transform duration-700 group-hover:scale-105" alt="Power Cell v4 battery" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAujOYG_7TZl-jA8tC6wfKEQaO6xczpZTFKV9aBEUUqcoVHzM7qKrDPZPxco_YARvlSi1m3mf7xvfxq1bgeYJfPr9yBkxK1pj0-0Cl1p5KwxX9wFgKAXF7bUQIefzXHKqiMLDyobBcyfzvgkN23Zah63xI1PlWhc5MXUsebwSTxUZAb2MV04PFqz-uDlXplCz-_5GNejx0dYu2JJIxjIfmeb9kmU0qlrTcbbUZOtSMqyJry3Ch43M2pmdyrzu5NxARZTth8LCphbtdS">
        <div class="absolute inset-0 bg-gradient-to-t from-stone-900/80 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-10 text-white">
          <span class="bg-[#FFC426] text-stone-900 px-3 py-1 rounded font-bold uppercase text-xs mb-4 inline-block">Flagship Tech</span>
          <h3 class="text-3xl font-bold uppercase mb-4" style="font-family: 'Space Grotesk', sans-serif;">Power Cell v4</h3>
          <p class="text-stone-300 max-w-md leading-relaxed" style="font-family: 'Lexend', sans-serif;">Our patented thermal shielding technology maintains optimal operating temperatures even under extreme heavy-load conditions.</p>
        </div>
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature_card' -%}
          <div class="md:col-span-4 bg-white border border-stone-100 p-8 flex flex-col justify-between rounded-xl hover:border-[#FFC426] transition-colors">
            <span class="material-symbols-outlined text-[#FFC426] text-4xl">{{ block.settings.icon }}</span>
            <div>
              <h4 class="text-xl font-bold uppercase mb-2" style="font-family: 'Space Grotesk', sans-serif;">{{ block.settings.title }}</h4>
              <p class="text-stone-500 text-sm leading-relaxed" style="font-family: 'Lexend', sans-serif;">{{ block.settings.description }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="md:col-span-4 bg-white border border-stone-100 p-8 flex flex-col justify-between rounded-xl hover:border-[#FFC426] transition-colors">
          <span class="material-symbols-outlined text-[#FFC426] text-4xl">bolt</span>
          <div>
            <h4 class="text-xl font-bold uppercase mb-2" style="font-family: 'Space Grotesk', sans-serif;">High Efficiency Motor</h4>
            <p class="text-stone-500 text-sm leading-relaxed" style="font-family: 'Lexend', sans-serif;">750W brushless DC motor with 98% efficiency rating.</p>
          </div>
        </div>
        <div class="md:col-span-4 bg-white border border-stone-100 p-8 flex flex-col justify-between rounded-xl hover:border-[#FFC426] transition-colors">
          <span class="material-symbols-outlined text-[#FFC426] text-4xl">battery_charging_full</span>
          <div>
            <h4 class="text-xl font-bold uppercase mb-2" style="font-family: 'Space Grotesk', sans-serif;">Smart BMS</h4>
            <p class="text-stone-500 text-sm leading-relaxed" style="font-family: 'Lexend', sans-serif;">Intelligent battery management with real-time monitoring.</p>
          </div>
        </div>
      {%- endfor -%}
      <div class="md:col-span-12 bg-stone-100 rounded-xl overflow-hidden flex flex-col md:flex-row items-center">
        <div class="p-10 flex-1">
          <h4 class="text-3xl font-bold uppercase mb-4" style="font-family: 'Space Grotesk', sans-serif;">Ultra-Connect Hub</h4>
          <p class="text-stone-600 mb-6 leading-relaxed" style="font-family: 'Lexend', sans-serif;">Seamless integration with your ecosystem. Real-time diagnostics, over-the-air updates, and military-grade GPS tracking.</p>
          <div class="flex gap-4">
            <span class="font-bold text-[#FFC426] uppercase text-sm tracking-widest">Bluetooth 5.3</span>
            <span class="font-bold text-[#FFC426] uppercase text-sm tracking-widest">5G Lte</span>
            <span class="font-bold text-[#FFC426] uppercase text-sm tracking-widest">RFID Lock</span>
          </div>
        </div>
        <div class="flex-1 h-full w-full bg-stone-200">
          <img class="w-full h-full object-cover" alt="Smartphone diagnostic app" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA1QG1vJZmszWb3D-g7Aa5-xVCuFLGGDOSDg76rNrvtqC0KrjAkT5RrGCCENIoKQSaS9DOQ8UShB3f2N6Jqj3tm_j1sVE4AuYpsr9ugLOJiXUyPGRGQEs6hKjsE5vQkPJOOO35LAo5KfERsj7nbLLjq7e5LJX6tMWBm7XqaqLE9woNGUZvBz3DxDj7w3poq4RF8h_nubr4XkwdRXJtMCvf3OJwgqflhK6RTlfyfllzgB1yJF7ySV8aM_AsvC1MMMwkwX1g3PGeilPap">
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-stone-50 py-[120px]">
  <div class="max-w-[1440px] mx-auto px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
      <div class="space-y-6">
        <div class="flex justify-between items-end">
          <div class="text-6xl font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">28</div>
          <div class="font-bold text-[#FFC426] uppercase text-sm tracking-widest mb-2" style="font-family: 'Space Grotesk', sans-serif;">MPH TOP SPEED</div>
        </div>
        <div class="w-full h-4 bg-white rounded-full overflow-hidden">
          <div class="h-full bg-gradient-to-r from-blue-500 to-[#FFC426] w-[85%]"></div>
        </div>
        <p class="text-stone-500 text-sm leading-relaxed" style="font-family: 'Lexend', sans-serif;">Unrestricted class-3 performance capabilities for rapid urban commuting.</p>
      </div>
      <div class="space-y-6">
        <div class="flex justify-between items-end">
          <div class="text-6xl font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">750</div>
          <div class="font-bold text-[#FFC426] uppercase text-sm tracking-widest mb-2" style="font-family: 'Space Grotesk', sans-serif;">W NOMINAL</div>
        </div>
        <div class="w-full h-4 bg-white rounded-full overflow-hidden">
          <div class="h-full bg-gradient-to-r from-blue-500 to-[#FFC426] w-[75%]"></div>
        </div>
        <p class="text-stone-500 text-sm leading-relaxed" style="font-family: 'Lexend', sans-serif;">High-efficiency brushless DC motor designed for peak power sustained output.</p>
      </div>
      <div class="space-y-6">
        <div class="flex justify-between items-end">
          <div class="text-6xl font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">4.0"</div>
          <div class="font-bold text-[#FFC426] uppercase text-sm tracking-widest mb-2" style="font-family: 'Space Grotesk', sans-serif;">INCH TREAD</div>
        </div>
        <div class="w-full h-4 bg-white rounded-full overflow-hidden">
          <div class="h-full bg-gradient-to-r from-blue-500 to-[#FFC426] w-[95%]"></div>
        </div>
        <p class="text-stone-500 text-sm leading-relaxed" style="font-family: 'Lexend', sans-serif;">Custom compound fat-tires providing maximum traction on loose terrain.</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-white py-[120px]">
