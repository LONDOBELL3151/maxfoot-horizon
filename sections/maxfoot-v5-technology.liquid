  </div>
</section>

<footer class="bg-white border-t border-stone-100 py-12">
  <div class="max-w-[1440px] mx-auto px-8 flex flex-col md:flex-row justify-between items-center gap-8">
    <div class="text-xl font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">{{ section.settings.brand_name }}</div>
    <div class="flex flex-wrap justify-center gap-8">
      <a class="text-stone-500 hover:text-[#FFC426] transition-colors font-bold uppercase text-xs tracking-widest" style="font-family: 'Space Grotesk', sans-serif;" href="#">Privacy Policy</a>
      <a class="text-stone-500 hover:text-[#FFC426] transition-colors font-bold uppercase text-xs tracking-widest" style="font-family: 'Space Grotesk', sans-serif;" href="#">Terms of Service</a>
      <a class="text-stone-500 hover:text-[#FFC426] transition-colors font-bold uppercase text-xs tracking-widest" style="font-family: 'Space Grotesk', sans-serif;" href="#">Warranty</a>
      <a class="text-stone-500 hover:text-[#FFC426] transition-colors font-bold uppercase text-xs tracking-widest" style="font-family: 'Space Grotesk', sans-serif;" href="#">Contact Us</a>
    </div>
    <p class="text-stone-500 text-sm">© 2024 MAXFOOT ELECTRIC BIKES. All rights reserved.</p>
  </div>
</footer>