              <div class="flex justify-center text-[#FFC426]">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
              </div>
            </td>
          </tr>
          <tr class="border-b border-stone-100 hover:bg-stone-50 transition-colors group">
            <td class="py-8">
              <div class="text-xl font-bold uppercase text-stone-400 group-hover:text-stone-900 transition-colors" style="font-family: 'Space Grotesk', sans-serif;">Heavy Load</div>
              <div class="text-xs uppercase tracking-widest text-stone-400">Utility Focused</div>
            </td>
            <td class="py-8 text-stone-600" style="font-family: 'Lexend', sans-serif;">Stepped power delivery for trailers and gear.</td>
            <td class="py-8 font-bold text-stone-400">Nominal</td>
            <td class="py-8 text-center">
              <div class="flex justify-center text-[#FFC426]">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="material-symbols-outlined">star</span>
                <span class="material-symbols-outlined">star</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="bg-white py-[120px]">
  <div class="max-w-[1440px] mx-auto px-8">
    <div class="bg-stone-900 rounded-2xl p-12 md:p-24 text-center relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <img class="w-full h-full object-cover" alt="Electric bike silhouette" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCaa5QxfUU79UB04sZ79UiJcePkxhC4UxluiLfheuWH3rbxQDR_JkmTmd1G8oInCFj5t2NmCktAVWaPymgy8tZwuH8B50vTNji9VtSSQu0RXhiKgGQodlLhay0pXExbFSu8sX3E8kfJqeQuSyH2AtYaspuEXVgibqaZOn_hviKxeDzKip2mOwF-4YJCn6GbEDhXXCluMwtbNEuIo2KK4fhxK6eC7VE9W7Wcwn5saYrHRmdvXzXLMLLwkBavrhOgb5QfWtg-QQ6IqV9t">
