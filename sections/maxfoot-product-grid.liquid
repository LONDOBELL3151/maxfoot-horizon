{% comment %}
  Maxfoot Product Grid Section - Product Listing Page
  Product cards with grayscale images, badges, wishlist buttons
{% endcomment %}

<section
  id="MaxfootProductGrid-{{ section.id }}"
  class="maxfoot-product-grid"
>
  {% comment %} Mobile filter toggle {% endcomment %}
  <div class="maxfoot-product-grid__mobile-toggle md:hidden">
    <span class="maxfoot-product-grid__count">{{ section.settings.product_count | default: 12 }} Bikes</span>
    <button class="maxfoot-product-grid__filter-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 21V14M4 10V3M12 21V12M12 8V3M20 21V16M20 12V3M1 14h6M9 8h6M17 16h6"/>
      </svg>
      Filters
    </button>
  </div>

  {% comment %} Product grid {% endcomment %}
  <div class="maxfoot-product-grid__grid">
    {% for i in (1..6) %}
      <div class="maxfoot-product-card">
        <div class="maxfoot-product-card__image-wrapper">
          {% assign placeholder_image = 'placeholder' | append: i %}
          <div class="maxfoot-product-card__placeholder"></div>
          <span class="maxfoot-product-card__badge maxfoot-product-card__badge--default">Best Seller</span>
          <button class="maxfoot-product-card__wishlist">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
        </div>
        <div class="maxfoot-product-card__content">
          <div class="maxfoot-product-card__header">
            <h3 class="maxfoot-product-card__title">MF-19 Fat Tire</h3>
            <span class="maxfoot-product-card__price">$1,699</span>
          </div>
          <p class="maxfoot-product-card__specs">
            <span class="maxfoot-product-card__spec">750W Motor</span>
            <span class="maxfoot-product-card__spec-divider">|</span>
            <span class="maxfoot-product-card__spec">60 Mile Range</span>
          </p>
          <a href="#" class="maxfoot-product-card__btn">View Details</a>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .maxfoot-product-grid {
    flex: 1;
  }

  .maxfoot-product-grid__mobile-toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .maxfoot-product-grid__count {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    color: #9a9a9a;
  }

  .maxfoot-product-grid__filter-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    background-color: #1a1c1c;
    border: 1px solid #2f3131;
    padding: 8px 16px;
    border-radius: 2px;
    cursor: pointer;
  }

  .maxfoot-product-grid__filter-btn svg {
    width: 18px;
    height: 18px;
  }

  .maxfoot-product-grid__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media screen and (min-width: 768px) {
    .maxfoot-product-grid__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1200px) {
    .maxfoot-product-grid__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .maxfoot-product-card {
    display: flex;
    flex-direction: column;
    background-color: #1a1c1c;
    border-radius: 8px;
    border: 1px solid transparent;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .maxfoot-product-card:hover {
    border-color: #00D4FF;
    box-shadow: 0 0 15px rgba(0, 212, 255, 0.3);
  }

  .maxfoot-product-card__image-wrapper {
    position: relative;
    aspect-ratio: 4/3;
    background-color: #252525;
    overflow: hidden;
  }

  .maxfoot-product-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #252525 0%, #1a1c1c 100%);
  }

  .maxfoot-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(80%);
    transition: all 0.7s ease;
  }

  .maxfoot-product-card:hover .maxfoot-product-card__image {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .maxfoot-product-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 2px;
  }

  .maxfoot-product-card__badge--default {
    background-color: #ffc426;
    color: #0A1628;
  }

  .maxfoot-product-card__badge--new {
    background-color: #333535;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .maxfoot-product-card__wishlist {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: rgba(10, 22, 40, 0.5);
    backdrop-filter: blur(8px);
    padding: 8px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    color: rgba(255, 255, 255, 0.5);
  }

  .maxfoot-product-card__wishlist:hover {
    color: #00D4FF;
  }

  .maxfoot-product-card__wishlist svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .maxfoot-product-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px;
  }

  .maxfoot-product-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .maxfoot-product-card__title {
    font-family: 'Lexend', sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #ffffff;
    margin: 0;
  }

  .maxfoot-product-card__price {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #00D4FF;
  }

  .maxfoot-product-card__specs {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    color: #9a9a9a;
    margin: 0 0 24px 0;
    flex: 1;
  }

  .maxfoot-product-card__spec {
    color: #00D4FF;
  }

  .maxfoot-product-card__spec-divider {
    color: #4a4a4a;
    margin: 0 4px;
  }

  .maxfoot-product-card__btn {
    display: block;
    width: 100%;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    color: #0A1628;
    background-color: #ffc426;
    padding: 12px 24px;
    border-radius: 2px;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .maxfoot-product-card__btn:hover {
    opacity: 0.9;
  }

  @media screen and (max-width: 767px) {
    .maxfoot-product-grid__mobile-toggle {
      margin-bottom: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Product Grid",
  "tag": "section",
  "class": "maxfoot-product-grid-section",
  "settings": [
    {
      "type": "number",
      "id": "product_count",
      "label": "Product Count",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Maxfoot Product Grid"
    }
  ]
}
{% endschema %}
