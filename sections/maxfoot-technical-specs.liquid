{% comment %}
  Maxfoot Technical Specs Section
  Dark background section showcasing motor/battery specs with progress bars
{% endcomment %}

<section
  id="MaxfootSpecs-{{ section.id }}"
  class="maxfoot-specs color-{{ section.settings.color_scheme }}"
>
  <div class="maxfoot-specs__container">
    <div class="maxfoot-specs__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'maxfoot-specs__image',
            alt: 'Electric bike motor detail',
            widths: '600, 900, 1200',
            sizes: '(min-width: 1024px) 58vw, 100vw',
            loading: 'lazy'
        }}
      {% else %}
        <div class="maxfoot-specs__image-placeholder"></div>
      {% endif %}
      <div class="maxfoot-specs__media-overlay"></div>
    </div>

    <div class="maxfoot-specs__content">
      <div class="maxfoot-specs__badge">{{ section.settings.badge_text }}</div>

      <h2 class="maxfoot-specs__heading">
        {{ section.settings.heading | default: 'Engineered<br/>For Performance' }}
      </h2>

      <p class="maxfoot-specs__description">
        {{ section.settings.description | default: 'Our proprietary drive system delivers instantaneous torque and sustained power. Built with aerospace-grade aluminum and integrated battery technology for a seamless, aggressive ride.' }}
      </p>

      <div class="maxfoot-specs__stats">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'stat' %}
              <div class="maxfoot-stat" {{ block.shopify_attributes }}>
                <div class="maxfoot-stat__header">
                  <span class="maxfoot-stat__label">{{ block.settings.label }}</span>
                  <span class="maxfoot-stat__value">{{ block.settings.value }}</span>
                </div>
                <div class="maxfoot-stat__bar">
                  <div
                    class="maxfoot-stat__fill"
                    style="--fill-width: {{ block.settings.percentage }}%"
                  ></div>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      <a href="{{ section.settings.button_link }}" class="maxfoot-specs__button">
        {{ section.settings.button_text | default: 'View Full Specs' }}
      </a>
    </div>
  </div>
</section>

<style>
  .maxfoot-specs {
    background-color: var(--color-background, #1a1c1c);
    padding: 120px 24px;
  }

  .maxfoot-specs__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    max-width: 1440px;
    margin: 0 auto;
    align-items: center;
  }

  @media screen and (min-width: 1024px) {
    .maxfoot-specs__container {
      grid-template-columns: 7fr 5fr;
      gap: 24px;
    }
  }

  .maxfoot-specs__media {
    position: relative;
    height: 400px;
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: #2f3131;
  }

  @media screen and (min-width: 1024px) {
    .maxfoot-specs__media {
      height: 600px;
    }
  }

  .maxfoot-specs__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    mix-blend-mode: luminosity;
  }

  .maxfoot-specs__image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #2f3131 0%, #1a1c1c 100%);
  }

  .maxfoot-specs__media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(26, 28, 28, 0.8) 80%,
      var(--color-background, #1a1c1c) 100%
    );
    display: none;
  }

  @media screen and (min-width: 1024px) {
    .maxfoot-specs__media-overlay {
      display: block;
    }
  }

  .maxfoot-specs__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    color: #ffffff;
  }

  .maxfoot-specs__badge {
    display: inline-flex;
    font-family: var(--font-heading-family, 'Space Grotesk', sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.5rem 0.75rem;
    border-radius: 0.125rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: var(--color-foreground, #1a1c1c);
    color: var(--color-primary, #ffc426);
    width: fit-content;
  }

  .maxfoot-specs__heading {
    font-family: var(--font-heading-family, 'Space Grotesk', sans-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: inherit;
    margin: 0;
  }

  .maxfoot-specs__description {
    font-family: var(--font-body-family, 'Lexend', sans-serif);
    font-size: 1.125rem;
    line-height: 1.6;
    color: #dadada;
    margin: 0;
    max-width: 500px;
  }

  .maxfoot-specs__stats {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .maxfoot-stat__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .maxfoot-stat__label {
    font-family: var(--font-heading-family, 'Space Grotesk', sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #e8e8e8;
  }

  .maxfoot-stat__value {
    font-family: var(--font-heading-family, 'Space Grotesk', sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary, #ffc426);
  }

  .maxfoot-stat__bar {
    width: 100%;
    height: 8px;
    background-color: var(--color-foreground, #1a1c1c);
    border-radius: 9999px;
    overflow: hidden;
  }

  .maxfoot-stat__fill {
    height: 100%;
    width: var(--fill-width, 0%);
    background-color: var(--color-primary, #ffc426);
    border-radius: 9999px;
  }

  .maxfoot-specs__button {
    font-family: var(--font-heading-family, 'Space Grotesk', sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 1rem 2rem;
    border-radius: 0.25rem;
    background-color: #ffffff;
    color: var(--color-foreground, #1a1c1c);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin-top: 1rem;
    transition: all 0.3s ease;
  }

  .maxfoot-specs__button:hover {
    background-color: var(--color-primary, #ffc426);
    color: var(--color-foreground, #1a1c1c);
  }

  @media screen and (max-width: 767px) {
    .maxfoot-specs {
      padding: 80px 16px;
    }

    .maxfoot-specs__media {
      height: 300px;
    }

    .maxfoot-specs__heading {
      font-size: 2rem;
    }

    .maxfoot-specs__description {
      font-size: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Technical Specs",
  "tag": "section",
  "class": "maxfoot-specs-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Architecture"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered<br/>For Performance"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our proprietary drive system delivers instantaneous torque and sustained power. Built with aerospace-grade aluminum and integrated battery technology for a seamless, aggressive ride."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View Full Specs"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button Link",
      "default": "/pages/technology"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "maxfoot-dark"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Bar",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Power Output"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "750W Peak"
        },
        {
          "type": "range",
          "id": "percentage",
          "label": "Fill Percentage",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 85
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maxfoot Technical Specs",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "label": "Power Output",
            "value": "750W Peak",
            "percentage": 85
          }
        },
        {
          "type": "stat",
          "settings": {
            "label": "Max Range",
            "value": "65 Miles",
            "percentage": 70
          }
        },
        {
          "type": "stat",
          "settings": {
            "label": "Charging Speed",
            "value": "Fast Charge",
            "percentage": 90
          }
        }
      ]
    }
  ]
}
{% endschema %}
