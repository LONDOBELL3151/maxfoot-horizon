{% schema %}
{
  "name": "V5 Product Detail",
  "tag": "section",
  "class": "maxfoot-v5-product-detail",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_gallery",
      "label": "Show Gallery",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Description",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Speed" },
        { "type": "text", "id": "value", "label": "Value", "default": "28 MPH" }
      ]
    }
  ],
  "presets": [{ "name": "V5 Product Detail" }]
}
{% endschema %}

{%- assign product_handle = section.settings.product -%}
{%- assign product = all_products[product_handle] -%}

{%- assign spec_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'spec' and block.settings.label != blank and block.settings.value != blank -%}
    {%- assign spec_count = spec_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<main>
  {%- if product and product != blank -%}
  <!-- PRODUCT GALLERY -->
  <section class="max-w-[1440px] mx-auto px-8 py-12 lg:py-20 grid grid-cols-1 lg:grid-cols-12 gap-12 bg-white">
    <div class="lg:col-span-7">
      <div class="aspect-square bg-stone-100 overflow-hidden rounded-xl">
        {%- if product.featured_image -%}
          <img class="w-full h-full object-cover" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}">
        {%- else -%}
          <div class="w-full h-full flex items-center justify-center text-stone-400">Product Image</div>
        {%- endif -%}
      </div>
      {%- if section.settings.show_gallery and product.images.size > 1 -%}
      <div class="grid grid-cols-4 gap-4 mt-4">
        {%- for image in product.images limit: 4 -%}
          <div class="aspect-square bg-stone-100 rounded-xl cursor-pointer hover:opacity-80 transition-opacity overflow-hidden">
            <img class="w-full h-full object-cover" src="{{ image | image_url: width: 200 }}" alt="{{ product.title }}">
          </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
    <div class="lg:col-span-5 flex flex-col justify-center">
      <span class="text-sm text-[#FFC426] font-bold tracking-widest uppercase mb-4" style="font-family: 'Space Grotesk', sans-serif;">NEW ARRIVAL</span>
      <h1 class="text-4xl lg:text-5xl font-bold text-stone-900 mb-4" style="font-family: 'Space Grotesk', sans-serif;">{{ product.title }}</h1>
      <div class="mb-6" style="font-family: 'Space Grotesk', sans-serif;">
        {%- if product.compare_at_price > product.price -%}
          <span class="text-stone-400 line-through text-xl mr-2">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="text-3xl font-bold text-[#FFC426]">{{ product.price | money }}</span>
      </div>
      {%- if section.settings.show_description -%}
      <p class="text-stone-600 mb-8 leading-relaxed" style="font-family: 'Lexend', sans-serif;">{{ product.description | default: product.metafields.custom.description | default: 'Experience the pinnacle of electric propulsion.' }}</p>
      {%- endif -%}

      <div class="grid {% if spec_count == 5 %}grid-cols-5{% elsif spec_count == 4 %}grid-cols-4{% elsif spec_count == 3 %}grid-cols-3{% elsif spec_count == 2 %}grid-cols-2{% else %}grid-cols-1{% endif %} gap-3 mb-8">
        {%- for block in section.blocks -%}
          {%- if block.type == 'spec' and block.settings.label != blank and block.settings.value != blank -%}
            <div class="bg-stone-50 p-3 rounded-xl text-center">
              <span class="block text-xs text-stone-400 uppercase tracking-widest mb-1">{{ block.settings.label }}</span>
              <span class="font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">{{ block.settings.value }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="flex gap-4">
        <form method="post" action="/cart/add" class="flex-1">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          <button type="submit" class="w-full bg-[#FFC426] text-stone-900 py-4 font-bold uppercase tracking-widest rounded-lg hover:opacity-90 transition-opacity" style="font-family: 'Space Grotesk', sans-serif;">ADD TO CART</button>
        </form>
        <button class="px-8 py-4 border-2 border-stone-900 text-stone-900 font-bold uppercase tracking-widest rounded-lg hover:bg-stone-900 hover:text-white transition-all" style="font-family: 'Space Grotesk', sans-serif;">BUY NOW</button>
      </div>
    </div>
  </section>
  {%- else -%}
  <!-- Empty State -->
  <section class="max-w-[1440px] mx-auto px-8 py-12 lg:py-20 grid grid-cols-1 lg:grid-cols-12 gap-12 bg-white">
    <div class="lg:col-span-7">
      <div class="aspect-square bg-stone-100 rounded-xl flex items-center justify-center">
        <span class="text-stone-400">Select a product to display</span>
      </div>
    </div>
    <div class="lg:col-span-5 flex flex-col justify-center">
      <span class="text-sm text-[#FFC426] font-bold tracking-widest uppercase mb-4">NEW ARRIVAL</span>
      <h1 class="text-4xl lg:text-5xl font-bold text-stone-900 mb-4" style="font-family: 'Space Grotesk', sans-serif;">MAXFOOT M-3</h1>
      <div class="mb-6"><span class="text-3xl font-bold text-[#FFC426]">$1,599.00</span></div>
      <p class="text-stone-600 mb-8">Experience the pinnacle of electric propulsion with the M-3.</p>
      {%- if spec_count > 0 -%}
      <div class="grid {% if spec_count == 5 %}grid-cols-5{% elsif spec_count == 4 %}grid-cols-4{% elsif spec_count == 3 %}grid-cols-3{% elsif spec_count == 2 %}grid-cols-2{% else %}grid-cols-1{% endif %} gap-3 mb-8">
        {%- for block in section.blocks -%}
          {%- if block.type == 'spec' and block.settings.label != blank and block.settings.value != blank -%}
            <div class="bg-stone-50 p-3 rounded-xl text-center">
              <span class="block text-xs text-stone-400 uppercase tracking-widest mb-1">{{ block.settings.label }}</span>
              <span class="font-bold text-stone-900" style="font-family: 'Space Grotesk', sans-serif;">{{ block.settings.value }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- else -%}
      <div class="grid grid-cols-4 gap-3 mb-8">
        <div class="bg-stone-50 p-3 rounded-xl text-center"><span class="block text-xs text-stone-400 uppercase tracking-widest mb-1">Speed</span><span class="font-bold">28 MPH</span></div>
        <div class="bg-stone-50 p-3 rounded-xl text-center"><span class="block text-xs text-stone-400 uppercase tracking-widest mb-1">Range</span><span class="font-bold">60 Miles</span></div>
        <div class="bg-stone-50 p-3 rounded-xl text-center"><span class="block text-xs text-stone-400 uppercase tracking-widest mb-1">Power</span><span class="font-bold text-[#FFC426]">750W</span></div>
        <div class="bg-stone-50 p-3 rounded-xl text-center"><span class="block text-xs text-stone-400 uppercase tracking-widest mb-1">Battery</span><span class="font-bold">48V 20Ah</span></div>
      </div>
      {%- endif -%}
      <div class="flex gap-4">
        <button class="flex-1 bg-[#FFC426] text-stone-900 py-4 font-bold uppercase tracking-widest rounded-lg">ADD TO CART</button>
        <button class="px-8 py-4 border-2 border-stone-900 text-stone-900 font-bold uppercase tracking-widest rounded-lg">BUY NOW</button>
      </div>
    </div>
  </section>
  {%- endif -%}
</main>