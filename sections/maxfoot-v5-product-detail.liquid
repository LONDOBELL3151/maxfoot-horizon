{% schema %}
{
  "name": "V5 Product Detail",
  "tag": "section",
  "class": "maxfoot-v5-product-detail",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "MAXFOOT"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "MAXFOOT M-3"
    },
    {
      "type": "textarea",
      "id": "product_description",
      "label": "Description",
      "default": "Experience the pinnacle of electric propulsion with the M-3."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$1,599"
    },
    {
      "type": "text",
      "id": "spec_speed",
      "label": "Speed Spec",
      "default": "28 MPH"
    },
    {
      "type": "text",
      "id": "spec_range",
      "label": "Range Spec",
      "default": "60 Miles"
    },
    {
      "type": "text",
      "id": "spec_power",
      "label": "Power Spec",
      "default": "750W"
    },
    {
      "type": "text",
      "id": "spec_battery",
      "label": "Battery Spec",
      "default": "48V 20Ah"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Nav Link",
      "settings": [
        { "type": "text", "id": "link_text", "label": "Link Text" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [{ "name": "V5 Product Detail" }]
}
{% endschema %}

<nav class="bg-white border-b border-stone-100 sticky top-0 z-50">
  <div class="flex justify-between items-center w-full px-6 py-4 max-w-[1440px] mx-auto">
    <div class="text-2xl font-black tracking-tighter text-stone-900">{{ section.settings.brand_name }}</div>
    <div class="hidden md:flex gap-8 items-center">
      {%- for block in section.blocks -%}{%- if block.type == 'nav_link' -%}<a class="text-stone-600 font-medium text-sm tracking-widest uppercase hover:text-yellow-500" href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a>{%- endif -%}{%- endfor -%}
    </div>
    <div class="flex items-center gap-6">
      <button class="material-symbols-outlined text-stone-600 hover:text-yellow-500">search</button>
      <button class="material-symbols-outlined text-stone-600 hover:text-yellow-500">shopping_cart</button>
    </div>
  </div>
</nav>

<main class="max-w-[1440px] mx-auto px-6 py-[120px]">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    <div class="aspect-square bg-stone-100 rounded-xl flex items-center justify-center">
      <span class="text-stone-400">Product Image</span>
    </div>
    <div class="flex flex-col justify-center">
      <span class="text-sm text-yellow-500 font-bold tracking-widest uppercase mb-4">NEW ARRIVAL</span>
      <h1 class="text-4xl font-bold text-stone-900 mb-4">{{ section.settings.product_title }}</h1>
      <p class="text-3xl font-bold text-yellow-500 mb-6">{{ section.settings.price }}</p>
      <p class="text-stone-600 mb-8">{{ section.settings.product_description }}</p>
      <div class="grid grid-cols-2 gap-4 mb-8">
        <div class="bg-stone-50 p-4 rounded-lg"><span class="block text-xs text-stone-400 uppercase">Speed</span><span class="font-bold">{{ section.settings.spec_speed }}</span></div>
        <div class="bg-stone-50 p-4 rounded-lg"><span class="block text-xs text-stone-400 uppercase">Range</span><span class="font-bold">{{ section.settings.spec_range }}</span></div>
        <div class="bg-stone-50 p-4 rounded-lg"><span class="block text-xs text-stone-400 uppercase">Power</span><span class="font-bold">{{ section.settings.spec_power }}</span></div>
        <div class="bg-stone-50 p-4 rounded-lg"><span class="block text-xs text-stone-400 uppercase">Battery</span><span class="font-bold">{{ section.settings.spec_battery }}</span></div>
      </div>
      <div class="flex gap-4">
        <button class="flex-1 bg-yellow-400 text-stone-900 py-4 font-bold uppercase tracking-widest rounded-lg hover:opacity-90">ADD TO CART</button>
        <button class="px-8 py-4 border-2 border-stone-900 text-stone-900 font-bold uppercase tracking-widest rounded-lg hover:bg-stone-900 hover:text-white transition-all">BUY NOW</button>
      </div>
    </div>
  </div>
</main>
