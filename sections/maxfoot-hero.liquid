{% comment %}
  Maxfoot Hero Section - Homepage
  Full-screen hero with background image, gradient overlay, headline and CTAs
{% endcomment %}

{% liquid
  assign image = section.settings.background_image
  assign heading = section.settings.heading | default: 'Conquer Every Terrain'
  assign subheading = section.settings.subheading | default: 'Unleash unparalleled power and precision. Engineered for those who demand more from the journey.'
  assign button_primary_text = section.settings.button_primary_text | default: 'Shop All Models'
  assign button_primary_link = section.settings.button_primary_link | default: '/collections/all'
  assign button_secondary_text = section.settings.button_secondary_text | default: 'Explore Technology'
  assign button_secondary_link = section.settings.button_secondary_link | default: '/pages/technology'
%}

<section
  id="MaxfootHero-{{ section.id }}"
  class="maxfoot-hero color-{{ section.settings.color_scheme }}"
  style="
    --hero-min-height: {{ section.settings.section_height }}vh;
    {% if image != blank %}
      --hero-bg-image: url('{{ image | image_url: width: 1920 }}');
    {% endif %}
  "
>
  {% if image != blank %}
    <div class="maxfoot-hero__bg">
      {{
        image
        | image_url: width: 1920
        | image_tag:
          class: 'maxfoot-hero__bg-image',
          alt: heading,
          widths: '750, 1200, 1920, 2560',
          sizes: '100vw',
          fetchpriority: 'high'
      }}
      <div class="maxfoot-hero__overlay"></div>
    </div>
  {% else %}
    <div class="maxfoot-hero__bg maxfoot-hero__bg--placeholder">
      <div class="maxfoot-hero__overlay"></div>
    </div>
  {% endif %}

  <div class="maxfoot-hero__content">
    <h1 class="maxfoot-hero__heading">{{ heading }}</h1>
    <p class="maxfoot-hero__subheading">{{ subheading }}</p>
    <div class="maxfoot-hero__actions">
      <a href="{{ button_primary_link }}" class="maxfoot-hero__btn maxfoot-hero__btn--primary">
        {{ button_primary_text }}
      </a>
      <a href="{{ button_secondary_link }}" class="maxfoot-hero__btn maxfoot-hero__btn--secondary">
        {{ button_secondary_text }}
      </a>
    </div>
  </div>
</section>

<style>
  .maxfoot-hero {
    position: relative;
    min-height: calc(var(--hero-min-height, 100vh) - var(--header-height, 0px));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .maxfoot-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .maxfoot-hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .maxfoot-hero__bg--placeholder {
    background: linear-gradient(135deg, #1a1c1c 0%, #2f3131 100%);
  }

  .maxfoot-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(26, 28, 28, 0.9) 0%,
      rgba(26, 28, 28, 0.4) 50%,
      rgba(26, 28, 28, 0.2) 100%
    );
  }

  .maxfoot-hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem;
    max-width: 900px;
    color: #ffffff;
  }

  .maxfoot-hero__heading {
    font-family: var(--font-heading-family, 'Space Grotesk', sans-serif);
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    color: inherit;
  }

  .maxfoot-hero__subheading {
    font-family: var(--font-body-family, 'Lexend', sans-serif);
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto 2rem;
    opacity: 0.9;
    color: inherit;
  }

  .maxfoot-hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
  }

  @media screen and (min-width: 640px) {
    .maxfoot-hero__actions {
      flex-direction: row;
      gap: 1rem;
    }
  }

  .maxfoot-hero__btn {
    font-family: var(--font-heading-family, 'Space Grotesk', sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 1rem 2rem;
    border-radius: 0.25rem;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 200px;
  }

  .maxfoot-hero__btn--primary {
    background-color: var(--color-primary-button-background, #ffc426);
    color: var(--color-primary-button-text, #1a1c1c);
    border: 2px solid var(--color-primary-button-background, #ffc426);
  }

  .maxfoot-hero__btn--primary:hover {
    background-color: var(--color-primary-button-hover-background, #1a1c1c);
    color: var(--color-primary-button-hover-text, #ffc426);
    border-color: var(--color-primary-button-hover-background, #1a1c1c);
  }

  .maxfoot-hero__btn--secondary {
    background-color: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
  }

  .maxfoot-hero__btn--secondary:hover {
    background-color: #ffffff;
    color: var(--color-foreground, #1a1c1c);
  }

  /* Page top offset for transparent header */
  .maxfoot-hero {
    margin-top: 0;
  }

  @media screen and (max-width: 749px) {
    .maxfoot-hero__content {
      padding: 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Hero",
  "tag": "section",
  "class": "maxfoot-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height",
      "min": 60,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Conquer Every Terrain"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Unleash unparalleled power and precision. Engineered for those who demand more from the journey."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "label": "Button Text",
      "default": "Shop All Models"
    },
    {
      "type": "text",
      "id": "button_primary_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "label": "Button Text",
      "default": "Explore Technology"
    },
    {
      "type": "text",
      "id": "button_secondary_link",
      "label": "Button Link",
      "default": "/pages/technology"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "maxfoot-dark"
    }
  ],
  "presets": [
    {
      "name": "Maxfoot Hero",
      "settings": {
        "section_height": 100,
        "heading": "Conquer Every Terrain",
        "subheading": "Unleash unparalleled power and precision. Engineered for those who demand more from the journey.",
        "button_primary_text": "Shop All Models",
        "button_primary_link": "/collections/all",
        "button_secondary_text": "Explore Technology",
        "button_secondary_link": "/pages/technology",
        "color_scheme": "maxfoot-dark"
      }
    }
  ]
}
{% endschema %}
