{% comment %}
  Maxfoot Hero Section - Homepage v4
  Full-screen hero with dark navy background, energy lines, and split layout
{% endcomment %}

{% liquid
  assign image = section.settings.background_image
  assign heading = section.settings.heading | default: 'Unleash the Raw Power'
  assign heading_accent = section.settings.heading_accent | default: 'Raw Power'
  assign subheading = section.settings.subheading | default: 'Engineered for the restless. Designed for the peak. The Maxfoot M-3 is a high-torque beast that treats mountains like playgrounds. Conquer every terrain with 1000W of pure adrenaline.'
  assign badge_text = section.settings.badge_text | default: 'New Generation E-MTB'
  assign button_primary_text = section.settings.button_primary_text | default: 'Pre-Order Now'
  assign button_primary_link = section.settings.button_primary_link | default: '/collections/all'
  assign button_secondary_text = section.settings.button_secondary_text | default: 'Technical Specs'
  assign button_secondary_link = section.settings.button_secondary_link | default: '/pages/technology'
%}

<section
  id="MaxfootHero-{{ section.id }}"
  class="maxfoot-hero"
>
  {% comment %} Energy lines background pattern {% endcomment %}
  <div class="maxfoot-hero__energy-lines"></div>

  {% comment %} Right side image {% endcomment %}
  {% if image != blank %}
    <div class="maxfoot-hero__image-side">
      {{
        image
        | image_url: width: 1920
        | image_tag:
          class: 'maxfoot-hero__image',
          alt: heading,
          widths: '750, 1200, 1920, 2560',
          sizes: '66vw',
          fetchpriority: 'high'
      }}
      <div class="maxfoot-hero__image-overlay"></div>
    </div>
  {% endif %}

  {% comment %} Content {% endcomment %}
  <div class="maxfoot-hero__container">
    <div class="maxfoot-hero__content">
      <div class="maxfoot-hero__badge-line">
        <span class="maxfoot-hero__badge-line-bar"></span>
        <span class="maxfoot-hero__badge-text">{{ badge_text }}</span>
      </div>

      <h1 class="maxfoot-hero__heading">
        <span class="maxfoot-hero__heading-light">Unleash the</span>
        <span class="maxfoot-hero__heading-accent">{{ heading_accent }}</span>
      </h1>

      <p class="maxfoot-hero__subheading">{{ subheading }}</p>

      <div class="maxfoot-hero__actions">
        <a href="{{ button_primary_link }}" class="maxfoot-hero__btn maxfoot-hero__btn--primary">
          {{ button_primary_text }}
        </a>
        <a href="{{ button_secondary_link }}" class="maxfoot-hero__link">
          {{ button_secondary_text }}
          <svg class="maxfoot-hero__link-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  {% comment %} Scroll indicator {% endcomment %}
  <div class="maxfoot-hero__scroll-indicator">
    <span class="maxfoot-hero__scroll-text">Scroll to Explore</span>
    <div class="maxfoot-hero__scroll-line"></div>
  </div>
</section>

<style>
  .maxfoot-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-color: #FFFFFF;
    overflow: hidden;
  }

  .maxfoot-hero__energy-lines {
    display: none;
  }

  .maxfoot-hero__image-side {
    position: absolute;
    right: 0;
    top: 0;
    width: 55%;
    height: 100%;
    overflow: hidden;
  }

  .maxfoot-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .maxfoot-hero__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      #FFFFFF 0%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 100%
    );
  }

  .maxfoot-hero__container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .maxfoot-hero__content {
    max-width: 580px;
    padding: 80px 0;
  }

  .maxfoot-hero__badge-line {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .maxfoot-hero__badge-line-bar {
    width: 48px;
    height: 4px;
    background-color: #ffc426;
  }

  .maxfoot-hero__badge-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #121212;
  }

  .maxfoot-hero__heading {
    margin: 0 0 24px 0;
    line-height: 1.05;
  }

  .maxfoot-hero__heading-light {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(48px, 7vw, 72px);
    font-weight: 400;
    color: #121212;
    letter-spacing: -0.02em;
  }

  .maxfoot-hero__heading-accent {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(48px, 7vw, 72px);
    font-weight: 700;
    color: #ffc426;
    letter-spacing: -0.02em;
  }

  .maxfoot-hero__subheading {
    font-family: 'Lexend', sans-serif;
    font-size: 18px;
    line-height: 1.7;
    color: #4c576c;
    max-width: 500px;
    margin: 0 0 40px 0;
  }

  .maxfoot-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px;
  }

  .maxfoot-hero__btn--primary {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 18px 40px;
    background-color: #ffc426;
    color: #121212;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .maxfoot-hero__btn--primary:hover {
    background-color: #121212;
    color: #ffc426;
    transform: translateY(-2px);
  }

  .maxfoot-hero__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #121212;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .maxfoot-hero__link:hover {
    color: #ffc426;
  }

  .maxfoot-hero__link-icon {
    transition: transform 0.3s ease;
  }

  .maxfoot-hero__link:hover .maxfoot-hero__link-icon {
    transform: translateX(4px);
  }

  .maxfoot-hero__scroll-indicator {
    display: none;
  }

  @media screen and (max-width: 1024px) {
    .maxfoot-hero__image-side {
      width: 100%;
      opacity: 0.15;
    }

    .maxfoot-hero__image-overlay {
      background: linear-gradient(
        to bottom,
        #FFFFFF 30%,
        rgba(255, 255, 255, 0.6) 100%
      );
    }
  }

  @media screen and (max-width: 767px) {
    .maxfoot-hero__container {
      padding: 0 24px;
    }

    .maxfoot-hero__content {
      padding: 120px 0 60px;
    }

    .maxfoot-hero__scroll-indicator {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot Hero",
  "tag": "section",
  "class": "maxfoot-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "New Generation E-MTB"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent",
      "default": "Raw Power"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered for the restless. Designed for the peak. The Maxfoot M-3 is a high-torque beast that treats mountains like playgrounds. Conquer every terrain with 1000W of pure adrenaline."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "label": "Button Text",
      "default": "Pre-Order Now"
    },
    {
      "type": "text",
      "id": "button_primary_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "label": "Link Text",
      "default": "Technical Specs"
    },
    {
      "type": "text",
      "id": "button_secondary_link",
      "label": "Link URL",
      "default": "/pages/technology"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "maxfoot-dark"
    }
  ],
  "presets": [
    {
      "name": "Maxfoot Hero",
      "settings": {
        "badge_text": "New Generation E-MTB",
        "heading_accent": "Raw Power",
        "subheading": "Engineered for the restless. Designed for the peak. The Maxfoot M-3 is a high-torque beast that treats mountains like playgrounds. Conquer every terrain with 1000W of pure adrenaline.",
        "button_primary_text": "Pre-Order Now",
        "button_primary_link": "/collections/all",
        "button_secondary_text": "Technical Specs",
        "button_secondary_link": "/pages/technology",
        "color_scheme": "maxfoot-dark"
      }
    }
  ]
}
{% endschema %}
