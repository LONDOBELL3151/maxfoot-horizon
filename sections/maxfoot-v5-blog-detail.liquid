{% schema %}
{
  "name": "V5 Blog Detail",
  "tag": "section",
  "class": "maxfoot-v5-blog-detail",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "KINETIC"
    },
    {
      "type": "text",
      "id": "category",
      "label": "Article Category",
      "default": "ADVENTURE"
    },
    {
      "type": "text",
      "id": "article_title",
      "label": "Article Title",
      "default": "THE ARCHITECTURE OF MOMENTUM."
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author Name",
      "default": "Marcus V."
    },
    {
      "type": "text",
      "id": "publish_date",
      "label": "Publish Date",
      "default": "Oct 24, 2026"
    },
    {
      "type": "text",
      "id": "read_time",
      "label": "Read Time",
      "default": "6 min read"
    },
    {
      "type": "textarea",
      "id": "author_bio",
      "label": "Author Bio",
      "default": "Lead Design Strategist at KINETIC. Marcus has spent two decades at the intersection of industrial design and electric propulsion, obsessed with the tactile nature of precision movement."
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Related Section Title",
      "default": "KEEP EXPLORING"
    },
    {
      "type": "text",
      "id": "view_journal_text",
      "label": "View Journal Link Text",
      "default": "View Journal"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Is Active",
          "default": false
        }
      ]
    },
    {
      "type": "content_paragraph",
      "name": "Content Paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Paragraph Text"
        },
        {
          "type": "checkbox",
          "id": "is_lead",
          "label": "Is Lead Paragraph",
          "default": false
        }
      ]
    },
    {
      "type": "pull_quote",
      "name": "Pull Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote_text",
          "label": "Quote Text"
        }
      ]
    },
    {
      "type": "related_post",
      "name": "Related Post",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "footer_link",
      "name": "Footer Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5 Blog Detail",
      "blocks": []
    }
  ]
}
{% endschema %}

{% stylesheet %}
<style>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    display: inline-block;
    vertical-align: middle;
    line-height: 1;
  }
</style>
{% endstylesheet %}

<!-- TopNavBar -->
<header class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-xl transition-all duration-300 shadow-xl shadow-slate-900/5">
  <nav class="flex justify-between items-center w-full px-8 py-4 max-w-screen-2xl mx-auto">
    <div class="text-2xl font-black tracking-tighter text-slate-900 uppercase">{{ section.settings.brand_name }}</div>
    <div class="hidden md:flex items-center gap-10">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_link' -%}
          <a
            class="text-slate-500 hover:text-slate-900 transition-colors tracking-tight font-medium {% if block.settings.is_active %}text-slate-900 border-b-2 border-[#FFC426] pb-1{% endif %}"
            href="{{ block.settings.link_url }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.link_text }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="flex items-center gap-6">
      <div class="hidden md:block">
        <span class="material-symbols-outlined text-slate-500 cursor-pointer hover:text-slate-900">search</span>
      </div>
      <button class="bg-[#FFC426] text-[#6a5400] px-6 py-2 rounded-lg font-bold tracking-tight active:scale-95 duration-200 ease-in-out">
        Configure
      </button>
    </div>
  </nav>
</header>

<main class="pt-24">
  <!-- Back Navigation -->
  <div class="max-w-screen-2xl mx-auto px-8 py-6">
    <a class="group flex items-center gap-2 text-slate-500 hover:text-slate-900 transition-colors" href="#">
      <span class="material-symbols-outlined transition-transform group-hover:-translate-x-1">arrow_back</span>
      <span class="font-medium tracking-tight text-sm uppercase">Back to Blog</span>
    </a>
  </div>

  <!-- Hero Image Section -->
  <section class="w-full relative aspect-[21/9] overflow-hidden bg-slate-100">
    <img alt="" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAbSWw2JKcX3hfH6DG_CD_akCODIa-bCuZjtnI4hoFeND6xZFeu4GfxAmst7T90ItQuNCKcP1EMyMGtfuISvQeSB6ye7LXW9P8Liezv2UA5t9tDjNYKvi39mf9DS0Wz3EkC5H1GHj9325SnomYgbuysDzG9ZL9FdJ_PHIv09cMF8OIhAV3417FfMyJJZWssHisC6u4WQBB9T4RBr2UvhR8zQDK5WpIWQp4vtZG56q1QYk-kAHIwydqa6n_Vvbo21WTBHrMaurgxzr8U" alt="">
  </section>

  <!-- Article Header -->
  <header class="max-w-4xl mx-auto text-center px-8 py-20">
    <span class="inline-block bg-[#FFC426] text-[#6a5400] text-xs font-bold tracking-widest px-4 py-1.5 rounded-full mb-8">{{ section.settings.category }}</span>
    <h1 class="text-6xl md:text-8xl font-black tracking-tighter leading-[0.9] text-slate-900 mb-8">{{ section.settings.article_title }}</h1>
    <div class="flex flex-col items-center gap-2 text-slate-500 font-medium">
      <div class="flex items-center gap-2">
        <span class="text-slate-900">By {{ section.settings.author_name }}</span>
        <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
        <span>{{ section.settings.publish_date }}</span>
        <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
        <span>{{ section.settings.read_time }}</span>
      </div>
    </div>
  </header>

  <!-- Article Content -->
  <article class="max-w-4xl mx-auto px-8 pb-20">
    <div class="leading-relaxed text-slate-800">
      {%- for block in section.blocks -%}
        {%- if block.type == 'content_paragraph' -%}
          <p class="{% if block.settings.is_lead %}text-2xl font-light leading-snug mb-12{% else %}mb-12{% endif %}">{{ block.settings.text }}</p>
        {%- endif -%}
        {%- if block.type == 'pull_quote' -%}
          <blockquote class="my-20 border-l-8 border-[#FFC426] pl-10 py-4 italic">
            <p class="text-4xl md:text-5xl font-bold text-slate-900 tracking-tight leading-tight">"{{ block.settings.quote_text }}"</p>
          </blockquote>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Share Section -->
    <div class="mt-20 py-12 border-t border-slate-100 flex flex-col md:flex-row justify-between items-center gap-8">
      <span class="font-bold tracking-widest text-xs uppercase text-slate-400">Share this Story</span>
      <div class="flex gap-8">
        <a class="text-slate-900 hover:text-[#FFC426] transition-colors" href="#"><span class="material-symbols-outlined">share</span></a>
        <a class="text-slate-900 hover:text-[#FFC426] transition-colors" href="#"><span class="material-symbols-outlined">alternate_email</span></a>
        <a class="text-slate-900 hover:text-[#FFC426] transition-colors" href="#"><span class="material-symbols-outlined">link</span></a>
      </div>
    </div>

    <!-- Author Bio -->
    <div class="mt-12 bg-[#f1f3ff] p-10 rounded-2xl flex flex-col md:flex-row items-center md:items-start gap-8">
      <div class="w-24 h-24 rounded-full overflow-hidden shrink-0 shadow-lg">
        <img alt="" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCr7N4E4hd0LQmFrBXT6P4Vep0LM6mI3W4C0TFbKKm5uhFPyiZV0GV2DGjp_D3mDf7ZXjie_FydDk1xobmwXJ-uP6fmTQIktc8wyDDPVCvxA0tRrfBaud82NCvuJ2zjqflEoSv8YKYME_LJVNeVWkg7eWZJfRpKwxU2BU6ai973nVJlcIlHpAlJa2_1i-koOPNGWtt4pZPjl6dPmkpQz4Npv-MSOpzuDiERUAgmCJKK2zfPO7OXAQgB2wRQaTjv_LwtS_LeiZrlXJK5" alt="">
      </div>
      <div class="text-center md:text-left">
        <h4 class="font-bold text-xl text-slate-900 mb-2">{{ section.settings.author_name }}</h4>
        <p class="text-slate-600 leading-relaxed">{{ section.settings.author_bio }}</p>
      </div>
    </div>
  </article>

  <!-- Related Posts Section -->
  <section class="bg-slate-50 py-32 mt-20">
    <div class="max-w-screen-2xl mx-auto px-8">
      <div class="flex justify-between items-end mb-16">
        <h2 class="text-5xl font-black tracking-tighter text-slate-900">{{ section.settings.section_title }}</h2>
        <a class="text-[#FFC426] font-bold tracking-widest text-sm uppercase flex items-center gap-2 hover:translate-x-2 transition-transform" href="#">
          {{ section.settings.view_journal_text }} <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        {%- for block in section.blocks -%}
          {%- if block.type == 'related_post' -%}
            <div class="group cursor-pointer" {{ block.shopify_attributes }}>
              <div class="aspect-[16/10] overflow-hidden rounded-xl mb-6 bg-slate-200">
                {%- if block.settings.image -%}
                  <img alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" src="{{ block.settings.image | image_url }}">
                {%- else -%}
                  <img alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBG2nPyevEiNlwCH-Wivnv96dbvHb_9_cj1YqTwe35igpdC-j9Jt7x9N06ctvI0dq1hpNl5vlK_b7J7lgcynf0fMwRzlHDb9xj5YcLyL47qtAp1485NQhQ2wjEYcSj1iobTjbjZ0Uy9MrpJ-Z2Z_8rZklvo3dUX1WsHdSWbFxfr-tqXLPIBEYgOQWxWPCAFJuwolmWBkMjSSYse-5dl58JAfkiZOG6eLiNfEqKAYtzdNIWnqt1E4ZshwP8Nx86LDSy4n0XaFwZhwY7E" alt="">
                {%- endif -%}
              </div>
              <span class="text-xs font-bold tracking-widest text-[#785a00] uppercase mb-4 block">{{ block.settings.category }}</span>
              <h3 class="text-2xl font-bold tracking-tight text-slate-900 group-hover:text-[#FFC426] transition-colors">{{ block.settings.title }}</h3>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</main>

<!-- Footer -->
<footer class="w-full mt-20 bg-slate-50">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full py-16 px-12 max-w-screen-2xl mx-auto items-center">
    <div class="space-y-6">
      <div class="text-xl font-bold text-slate-900">{{ section.settings.brand_name }}</div>
      <div class="text-slate-500 uppercase tracking-widest text-xs">
        © 2024 {{ section.settings.brand_name }} MONOLITH. PRECISION E-MOBILITY.
      </div>
    </div>
    <div class="flex flex-wrap gap-x-8 gap-y-4 md:justify-end">
      {%- for block in section.blocks -%}
        {%- if block.type == 'footer_link' -%}
          <a class="uppercase tracking-widest text-xs text-slate-500 hover:text-[#FFC426] transition-colors" href="{{ block.settings.link_url }}" {{ block.shopify_attributes }}>
            {{ block.settings.link_text }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</footer>