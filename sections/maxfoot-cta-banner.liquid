{% comment %}
  Maxfoot CTA Banner Section - Product Detail Page
  Dark navy background with diagonal accent and centered CTA buttons
{% endcomment %}

<section
  id="MaxfootCTABanner-{{ section.id }}"
  class="maxfoot-cta-banner"
>
  <div class="maxfoot-cta-banner__accent"></div>

  <div class="maxfoot-cta-banner__container">
    <div class="maxfoot-cta-banner__badge">{{ section.settings.badge | default: 'Ready to Evolve?' }}</div>

    <h2 class="maxfoot-cta-banner__heading">{{ section.settings.heading | default: 'STOP WATCHING. START RIDING.' }}</h2>

    <p class="maxfoot-cta-banner__description">
      {{ section.settings.description | default: 'Join the 10,000+ explorers who have transitioned to the Horizon ecosystem. Free shipping and local setup included with every purchase.' }}
    </p>

    <div class="maxfoot-cta-banner__actions">
      <a href="{{ section.settings.button_primary_link }}" class="maxfoot-cta-banner__btn maxfoot-cta-banner__btn--primary">
        {{ section.settings.button_primary_text | default: 'Configure Your Horizon' }}
      </a>
      <a href="{{ section.settings.button_secondary_link }}" class="maxfoot-cta-banner__btn maxfoot-cta-banner__btn--secondary">
        {{ section.settings.button_secondary_text | default: 'Locate Retailer' }}
      </a>
    </div>
  </div>
</section>

<style>
  .maxfoot-cta-banner {
    position: relative;
    background-color: #FFFFFF;
    padding: 100px 48px;
    overflow: hidden;
    text-align: center;
  }

  .maxfoot-cta-banner__accent {
    display: none;
  }

  .maxfoot-cta-banner__container {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  .maxfoot-cta-banner__badge {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #ffc426;
    margin-bottom: 16px;
  }

  .maxfoot-cta-banner__heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #121212;
    margin: 0 0 20px 0;
  }

  .maxfoot-cta-banner__description {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6b6b6b;
    margin: 0 0 40px 0;
  }

  .maxfoot-cta-banner__actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
    align-items: center;
  }

  @media screen and (min-width: 640px) {
    .maxfoot-cta-banner__actions {
      flex-direction: row;
      gap: 20px;
    }
  }

  .maxfoot-cta-banner__btn {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 16px 36px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .maxfoot-cta-banner__btn--primary {
    background-color: #ffc426;
    color: #121212;
  }

  .maxfoot-cta-banner__btn--primary:hover {
    background-color: #121212;
    color: #ffc426;
  }

  .maxfoot-cta-banner__btn--secondary {
    background-color: transparent;
    color: #121212;
    border: 2px solid #121212;
  }

  .maxfoot-cta-banner__btn--secondary:hover {
    background-color: #121212;
    color: #ffffff;
    border-color: #121212;
  }

  @media screen and (max-width: 767px) {
    .maxfoot-cta-banner {
      padding: 64px 24px;
    }

    .maxfoot-cta-banner__btn {
      width: 100%;
      max-width: 320px;
      padding: 14px 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Maxfoot CTA Banner",
  "tag": "section",
  "class": "maxfoot-cta-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Ready to Evolve?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STOP WATCHING. START RIDING."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join the 10,000+ explorers who have transitioned to the Horizon ecosystem. Free shipping and local setup included with every purchase."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "label": "Button Text",
      "default": "Configure Your Horizon"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "label": "Button Text",
      "default": "Locate Retailer"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Maxfoot CTA Banner",
      "settings": {
        "badge": "Ready to Evolve?",
        "heading": "STOP WATCHING. START RIDING.",
        "description": "Join the 10,000+ explorers who have transitioned to the Horizon ecosystem. Free shipping and local setup included with every purchase.",
        "button_primary_text": "Configure Your Horizon",
        "button_secondary_text": "Locate Retailer"
      }
    }
  ]
}
{% endschema %}
